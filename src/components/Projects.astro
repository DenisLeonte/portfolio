---
import projects from '../data/projects.json';
---

<section id="projects">
  <div class="section-inner">
    <div class="section-head">
      <div class="meta">
        <div class="section-num">03 / work</div>
        <div class="section-tag" data-i18n="projects.sectionTag">case studies & side quests</div>
      </div>
      <h2 class="section-title" data-i18n-html="projects.sectionTitle">
        Selected <em>work</em> from production lines and late nights.
      </h2>
    </div>

    <div id="projects-list">
      {projects.map((p, i) => (
        <a
          class="project-row"
          href={p.liveUrl && !p.liveUrl.startsWith('[') ? p.liveUrl : (p.githubUrl && !p.githubUrl.startsWith('[') ? p.githubUrl : '#')}
          target={p.liveUrl && !p.liveUrl.startsWith('[') ? '_blank' : undefined}
          rel="noopener noreferrer"
        >
          <div class="project-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="project-name">{p.name}</div>
          <div class="project-meta">{p.techStack.filter(t => !t.startsWith('[')).slice(0, 2).join(' · ')}</div>
          <div class="project-tags-row">
            {p.techStack.filter(t => !t.startsWith('[')).map(t => (
              <span class="ptag">{t}</span>
            ))}
          </div>
          <div class="project-arrow">→</div>
          <div class="project-preview">
            <div class="project-preview-inner">
              {p.image && !p.image.startsWith('[') ? (
                <img src={p.image} alt={p.name} loading="lazy" />
              ) : (
                <div class="preview-placeholder">[ {p.name} ]</div>
              )}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="more-strip">
      <div class="more-text" data-i18n-html="projects.moreText">
        More <em>where that came from</em> — restaurants, e-commerce, agencies.
      </div>
      <a href="/showcase" class="btn-v2 btn-v2-primary" data-i18n="projects.viewShowcase">View Showcase →</a>
    </div>
  </div>
</section>

<style>
  #projects {
    background: var(--bg);
    padding: 120px 32px;
    position: relative;
    z-index: 1;
  }

  .section-inner { max-width: 1400px; margin: 0 auto; }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 80px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .section-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .section-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-tag::before { content: '— '; opacity: 0.5; }
  .section-title {
    font-family: var(--sans);
    font-size: clamp(28px, 4vw, 60px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0;
  }
  .section-title em, .section-title :global(em) {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }

  /* Project rows */
  .project-row {
    display: grid;
    grid-template-columns: 60px 1fr 200px 220px 60px;
    align-items: center;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
    transition: all 0.3s;
    cursor: pointer;
    position: relative;
  }
  .project-row:last-child { border-bottom: 1px solid var(--line); }
  .project-row:hover { background: var(--bg2); padding-left: 24px; padding-right: 24px; }

  .project-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
  }
  .project-row:hover .project-num { color: var(--green); }

  .project-name {
    font-family: var(--sans);
    font-size: clamp(20px, 2.8vw, 38px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: color 0.2s;
  }
  .project-row:hover .project-name { color: var(--green); }

  .project-meta {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-tags-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .ptag {
    font-family: var(--mono);
    font-size: 9px;
    padding: 3px 8px;
    border: 1px solid var(--line);
    color: var(--text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-arrow {
    font-family: var(--mono);
    font-size: 24px;
    color: var(--text-faint);
    text-align: right;
    transition: all 0.2s;
  }
  .project-row:hover .project-arrow { color: var(--green); transform: translateX(8px); }

  /* Hover preview */
  .project-preview {
    position: absolute;
    pointer-events: none;
    width: 320px; height: 200px;
    background: var(--bg3);
    border: 1px solid var(--line-strong);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.2s, transform 0.2s;
    z-index: 10;
    overflow: hidden;
    left: 50%; top: -220px;
  }
  .project-row:hover .project-preview { opacity: 1; transform: scale(1); }
  .project-preview-inner { width: 100%; height: 100%; }
  .project-preview-inner img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .preview-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    background: repeating-linear-gradient(-45deg, var(--bg3), var(--bg3) 8px, rgba(255,255,255,0.02) 8px, rgba(255,255,255,0.02) 16px);
  }

  /* More strip */
  .more-strip {
    margin-top: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 28px 0;
    gap: 24px;
    flex-wrap: wrap;
  }
  .more-text {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 3vw, 36px);
    color: var(--text);
    line-height: 1.2;
  }
  .more-text em, .more-text :global(em) { color: var(--green); }

  .btn-v2 {
    font-family: var(--mono);
    font-size: 11px;
    padding: 14px 22px;
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .btn-v2:hover { border-color: var(--text); }
  .btn-v2-primary { background: var(--green); border-color: var(--green); color: var(--bg); }
  .btn-v2-primary:hover { background: var(--bone); border-color: var(--bone); color: var(--bg); }

  @media (max-width: 1100px) {
    .section-head { grid-template-columns: 1fr; gap: 24px; }
    .project-row { grid-template-columns: 40px 1fr 140px 36px; gap: 16px; }
    .project-row .project-tags-row { display: none; }
    .project-preview { display: none; }
    .project-row:hover { padding-left: 12px; padding-right: 12px; }
  }
  @media (max-width: 720px) {
    #projects { padding: 80px 16px; }
    .project-row { grid-template-columns: 36px 1fr 32px; gap: 12px; padding: 20px 0; }
    .project-meta { display: none; }
    .project-name { font-size: 20px; }
    .more-strip { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (max-width: 420px) {
    .project-row { grid-template-columns: 1fr 32px; }
    .project-num { display: none; }
  }
</style>

<script>
  // Position preview near cursor
  document.querySelectorAll<HTMLElement>('.project-row').forEach(row => {
    const preview = row.querySelector<HTMLElement>('.project-preview');
    if (!preview) return;
    row.addEventListener('mousemove', (e: MouseEvent) => {
      const r = row.getBoundingClientRect();
      preview.style.left = (e.clientX - r.left - 160) + 'px';
      preview.style.top  = (e.clientY - r.top - 220) + 'px';
    });
  });
</script>
