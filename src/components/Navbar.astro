---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const a = (hash: string) => isHome ? hash : `/${hash}`;
---

<nav id="navbar" aria-label="Primary navigation">
  <a href={a('#hero')} class="nav-logo" aria-label="Back to top">
    <img src="/favicon.svg" alt="Leonte Denis portfolio logo" class="nav-logo-img" width="24" height="24" />
    <span class="nav-logo-blink"></span>
    <span>DENIS.EXE</span>
  </a>

  <ul class="nav-links" role="list">
    <li><a href={a('#about')}    data-i18n="nav.about">About</a></li>
    <li><a href={a('#skills')}   data-i18n="nav.skills">Skills</a></li>
    <li><a href={a('#projects')} data-i18n="nav.projects">Work</a></li>
    <li><a href="/showcase"      data-i18n="nav.showcase">Showcase</a></li>
    <li><a href="/tech"          data-i18n="nav.tech">Tech</a></li>
  </ul>

  <div class="nav-right">
    <div class="nav-toggles">
      <LanguageToggle />
      <ThemeToggle />
    </div>
    <a href="/contact" class="nav-cta" data-i18n="nav.contact">Let's Talk</a>
    <button
      id="hamburger"
      class="nav-hamburger"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile Menu -->
<div id="mobile-menu" aria-hidden="true">
  <a href={a('#about')}    data-i18n="nav.about">About</a>
  <a href={a('#skills')}   data-i18n="nav.skills">Skills</a>
  <a href={a('#projects')} data-i18n="nav.projects">Work</a>
  <a href="/showcase"      data-i18n="nav.showcase">Showcase</a>
  <a href="/tech"          data-i18n="nav.tech">Tech</a>
  <a href="/contact"       data-i18n="nav.contact">Contact</a>
  <div class="mobile-toggles">
    <LanguageToggle mobile={true} />
    <ThemeToggle twoWay={true} />
  </div>
</div>

<style>
  nav#navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    gap: 0;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.3s;
  }

  .nav-logo {
    color: var(--text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.15em;
    flex-shrink: 0;
  }
  .nav-logo-img {
    width: 24px; height: 24px;
    border-radius: 4px;
    display: block;
    flex-shrink: 0;
  }
  .nav-logo-blink {
    width: 6px; height: 6px;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    animation: blink-dot 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes blink-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }

  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
    margin-left: 40px;
  }
  .nav-links a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 1px;
    background: var(--green);
    transition: width 0.25s ease;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { width: 100%; }
  .nav-links a.active { color: var(--green); }
  .nav-links a.active::after { width: 100%; }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }
  .nav-toggles {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-cta {
    padding: 8px 16px;
    border: 1px solid var(--line-strong);
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nav-cta::after { content: '↗'; font-size: 12px; }
  .nav-cta:hover {
    background: var(--green);
    border-color: var(--green);
    color: var(--bg);
  }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    min-width: 44px; min-height: 44px;
    align-items: center; justify-content: center;
    touch-action: manipulation;
  }
  .nav-hamburger span {
    display: block;
    width: 22px; height: 1px;
    background: var(--text);
    transition: all 0.3s;
  }

  #mobile-menu {
    display: none;
    position: fixed;
    top: 52px; left: 0; right: 0;
    background: var(--bg2);
    border-bottom: 1px solid var(--line);
    padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
    flex-direction: column;
    gap: 0;
    z-index: 999;
    overscroll-behavior: contain;
  }
  #mobile-menu.open { display: flex; }
  #mobile-menu a {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
    padding: 0;
    min-height: 52px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s;
    touch-action: manipulation;
  }
  #mobile-menu a:hover,
  #mobile-menu a:active { color: var(--green); }
  .mobile-toggles {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    nav#navbar { padding: 12px 16px; }
    .nav-links { display: none; }
    .nav-toggles { display: none; }
    .nav-cta { display: none; }
    .nav-hamburger { display: flex; }
  }
</style>

<script>
  let _scrollHandler: (() => void) | null = null;
  let _sectionObserver: IntersectionObserver | null = null;

  document.addEventListener('astro:page-load', () => {
    const navbar  = document.getElementById('navbar')!;
    const burger  = document.getElementById('hamburger')!;
    const mobileMenu = document.getElementById('mobile-menu')!;
    const mobileLinks = mobileMenu?.querySelectorAll('a') ?? [];

    // Scroll effect
    if (_scrollHandler) window.removeEventListener('scroll', _scrollHandler);
    _scrollHandler = () => {
      navbar.style.background = window.scrollY > 60
        ? `color-mix(in srgb, var(--bg) 95%, transparent)`
        : `color-mix(in srgb, var(--bg) 80%, transparent)`;
    };
    window.addEventListener('scroll', _scrollHandler, { passive: true });

    // Mobile toggle
    let open = false;
    const toggle = () => {
      open = !open;
      burger.setAttribute('aria-expanded', String(open));
      mobileMenu.setAttribute('aria-hidden', String(!open));
      mobileMenu.classList.toggle('open', open);
    };
    burger.addEventListener('click', toggle);
    mobileLinks.forEach(l => l.addEventListener('click', () => { if (open) toggle(); }));

    // Active section highlighting
    if (_sectionObserver) _sectionObserver.disconnect();
    const navLinks = document.querySelectorAll('.nav-links a');
    _sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navLinks.forEach(link => {
              const href = link.getAttribute('href') ?? '';
              link.classList.toggle('active', href === '#' + entry.target.id);
            });
          }
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    document.querySelectorAll('section[id]').forEach(s => _sectionObserver!.observe(s));

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', e => {
        const href = (anchor as HTMLAnchorElement).getAttribute('href');
        if (!href || href === '#') return;
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>
