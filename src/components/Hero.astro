---
import profile from '../data/profile.json';
import pkg from '../../package.json';
const version = pkg.version;
---

<section id="hero" data-fx="aurora">
  <div class="hero-top-bar">
    <div class="htb-left">
      <span class="htb-muted">// status</span>
      <span class="htb-green">● available for work</span>
    </div>
    <div class="htb-center">
      <span>Cluj, Romania</span>
      <span class="htb-sep">·</span>
      <span id="hero-time">--:--:--</span>
    </div>
    <div class="htb-right">
      <span>v{version}</span>
    </div>
  </div>

  <pre class="hero-ascii" id="hero-ascii" aria-hidden="true">
   ░▒▓██████▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
   ░▒▓██████▓▒░</pre>

  <h1 class="hero-stack">
    <span class="line"><span>Full-stack</span></span>
    <span class="line"><span><span class="amp">&amp;</span><span class="outline">backend</span></span></span>
    <span class="line"><span><span class="amp">&amp;</span>frontend</span></span>
    <span class="line"><span><span class="amp">&amp;</span><span class="outline">data ops</span></span></span>
  </h1>

  <div class="hero-bottom">
    <div class="hb-block">
      <div class="hb-lbl">/ who</div>
      <div class="hb-val big">{profile.name}</div>
      <div class="hb-sub">Software Engineer</div>
    </div>
    <div class="hb-block">
      <div class="hb-lbl">/ currently</div>
      <div class="hb-val">
        Building enterprise systems at <span class="hb-green">.msg Systems</span> on a Mercedes-Benz Group project.
      </div>
    </div>
    <div class="hb-cta">
      <a href="#projects" class="btn-v2 btn-v2-primary">View Work →</a>
      <a href="/resume.pdf" download class="btn-v2">Resume ↗</a>
    </div>
  </div>
</section>

<style>
  #hero {
    min-height: 100vh;
    padding: 120px 32px 0;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    z-index: 1;
    background: var(--bg);
  }

  .hero-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
    margin-bottom: 80px;
  }
  .htb-left, .htb-center, .htb-right { display: flex; gap: 12px; align-items: center; }
  .htb-muted { color: var(--text-faint); }
  .htb-green { color: var(--green); }
  .htb-sep { color: var(--text-faint); }

  .hero-ascii {
    position: absolute;
    top: 120px; right: 32px;
    font-family: var(--mono);
    font-size: 9px;
    line-height: 1.1;
    color: var(--text-faint);
    white-space: pre;
    pointer-events: none;
    user-select: none;
    opacity: 0.6;
    text-align: right;
  }

  .hero-stack {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(48px, 11.5vw, 180px);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin-bottom: 48px;
    color: var(--text);
  }
  .hero-stack .line {
    display: block;
    overflow: hidden;
  }
  .hero-stack .line span {
    display: inline-block;
    animation: lineUp 1s cubic-bezier(0.22,1,0.36,1) forwards;
    transform: translateY(110%);
  }
  .hero-stack .line:nth-child(1) span { animation-delay: 0.1s; }
  .hero-stack .line:nth-child(2) span { animation-delay: 0.25s; }
  .hero-stack .line:nth-child(3) span { animation-delay: 0.4s; }
  .hero-stack .line:nth-child(4) span { animation-delay: 0.55s; }

  .amp {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
    margin-right: 0.1em;
  }
  .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 32px;
    border-top: 1px solid var(--line);
    padding: 32px 0;
    align-items: start;
    opacity: 0;
    animation: fadeUp 0.8s 0.9s forwards;
  }

  .hb-lbl {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-faint);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .hb-val {
    font-family: var(--sans);
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
  }
  .hb-val.big { font-size: 22px; font-weight: 500; }
  .hb-sub { color: var(--text-dim); font-size: 13px; margin-top: 4px; }
  .hb-green { color: var(--green); }

  .hb-cta {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .btn-v2 {
    font-family: var(--mono);
    font-size: 11px;
    padding: 14px 22px;
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.2s;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn-v2:hover { border-color: var(--text); color: var(--text); }
  .btn-v2-primary {
    background: var(--green);
    border-color: var(--green);
    color: var(--bg);
  }
  .btn-v2-primary:hover { background: var(--bone); border-color: var(--bone); color: var(--bg); }

  @keyframes lineUp {
    from { transform: translateY(110%); }
    to   { transform: translateY(0); }
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1100px) {
    .hero-bottom { grid-template-columns: 1fr 1fr; }
    .hb-cta { grid-column: span 2; justify-content: flex-start; }
  }
  @media (max-width: 720px) {
    #hero { padding: 90px 16px 0; }
    .hero-ascii { display: none; }
    .hero-top-bar {
      flex-direction: column;
      gap: 6px;
      align-items: flex-start;
      font-size: 9px;
      margin-bottom: 40px;
    }
    .htb-right { display: none; }
    .hero-stack { font-size: clamp(36px, 10vw, 80px); margin-bottom: 32px; }
    .hero-bottom { grid-template-columns: 1fr; gap: 20px; }
    .hb-cta { grid-column: span 1; justify-content: flex-start; flex-wrap: wrap; }
    .btn-v2 { font-size: 10px; padding: 12px 16px; }
  }
  @media (max-width: 420px) {
    .hero-stack { font-size: 32px; }
    .hb-val.big { font-size: 18px; }
  }
</style>

<script>
  // Live clock
  function tick() {
    const el = document.getElementById('hero-time');
    if (el) {
      el.textContent = new Date().toLocaleTimeString('en-GB', { hour12: false }) + ' EET';
    }
  }
  tick();
  setInterval(tick, 1000);

  // ASCII pulse
  const asciiFrames = [
`   ░▒▓██████▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
  ░▒▓█▓▒░░▒▓█▓▒░
   ░▒▓██████▓▒░`,
`   ▒▓██████▓░
  ▓█▓▒░░▒▓█▓░
  █▓▒░░▒▓█▓▒
  ▓▒░░▒▓█▓▒░
  ▒░░▒▓█▓▒░▒
   ▓██████▓▒`,
`   ▓████████░
  █░░▒▓▓▓▒░█
  █░▒▓██▓▒░░
  █░░▒▓▓▒░░░
  █▓▒░░░▒▓░░
   ████████▓`,
  ];
  let idx = 0;
  setInterval(() => {
    idx = (idx + 1) % asciiFrames.length;
    const el = document.getElementById('hero-ascii');
    if (el) el.textContent = asciiFrames[idx];
  }, 600);
</script>
