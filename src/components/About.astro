---
import profile from '../data/profile.json';
---

<section id="desktop">
  <div class="section-inner">
    <div class="section-head">
      <div class="meta">
        <div class="section-num">01 / about</div>
        <div class="section-tag">desktop</div>
      </div>
      <h2 class="section-title">
        A small <em>workstation</em> tour.<br>Move the windows, peek at the files — that's me.
      </h2>
    </div>

    <div class="desktop-board" id="desktop-board">

      <!-- Icons: column A — window spawners (right:108px) -->
      <div class="desktop-icon" style="top:24px;right:108px" tabindex="0" aria-label="About" data-spawns="win-about">
        <div class="desktop-icon-img">
          <svg width="20" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div>ABOUT.MD</div>
      </div>
      <div class="desktop-icon" style="top:140px;right:108px" tabindex="0" aria-label="Hobbies" data-spawns="win-hobbies">
        <div class="desktop-icon-img">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
        </div>
        <div>HOBBIES</div>
      </div>
      <div class="desktop-icon" style="top:256px;right:108px" tabindex="0" aria-label="Stats" data-spawns="win-stats">
        <div class="desktop-icon-img">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="18" y="3" width="4" height="18"/><rect x="10" y="8" width="4" height="13"/><rect x="2" y="13" width="4" height="8"/></svg>
        </div>
        <div>STATS.TXT</div>
      </div>
      <div class="desktop-icon" style="top:372px;right:108px" tabindex="0" aria-label="Config" data-spawns="win-config">
        <div class="desktop-icon-img">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/></svg>
        </div>
        <div>CONFIG</div>
      </div>
      <div class="desktop-icon" style="top:488px;right:108px" tabindex="0" aria-label="Now playing" data-spawns="win-now">
        <div class="desktop-icon-img">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </div>
        <div>NOW.WAV</div>
      </div>
      <div class="desktop-icon" style="top:604px;right:108px" tabindex="0" aria-label="Work folder" data-spawns="win-work">
        <div class="desktop-icon-img">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h6l2 2h10v11H3z"/></svg>
        </div>
        <div>WORK</div>
      </div>

      <!-- Icons: column B — utilities (right:24px) -->
      <div class="desktop-icon" style="top:24px;right:24px" tabindex="0" aria-label="Resume" data-icon="resume">
        <div class="desktop-icon-img">
          <svg width="20" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 3H6v18h12V7zM14 3v4h4M9 12h6M9 16h6M9 8h2"/></svg>
        </div>
        <div>RESUME</div>
      </div>
      <div class="desktop-icon" style="top:140px;right:24px" tabindex="0" aria-label="Bugs" data-icon="bugs">
        <div class="desktop-icon-img">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 7h14M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6"/></svg>
        </div>
        <div>BUGS</div>
      </div>

      <!-- about-me.md window -->
      <div id="win-about" class="win win-about" data-win data-no-restore>
        <div class="win-header" aria-label="Drag window">
          <div class="win-dots">
            <div class="dot r"></div><div class="dot y"></div><div class="dot g"></div>
          </div>
          <div class="win-title">about-me.md</div>
        </div>
        <div class="win-body">
          <div class="win-hi">Hi, I'm Denis.</div>
          <p>I'm a <strong>full-stack engineer</strong> with 2+ years building enterprise apps. I hold an M.Sc. in <strong>High Performance Computing & Big Data</strong>, which keeps me biased toward performant, data-driven design.</p>
          <p>Day job: <strong>.msg Systems Romania</strong> on a Mercedes-Benz Group project — Spring Boot, Angular, and the messy real-world middleware between them.</p>
          <p>Night mode: cooking, cars, the night sky, and the pursuit of a better espresso shot.</p>
          <div class="win-links">
            <a href={profile.socialLinks.github} target="_blank" rel="noopener">github ↗</a>
            <a href="/tech">how this site works ↗</a>
            <a href="/resume.pdf" download>resume.pdf ↗</a>
          </div>
        </div>
      </div>

      <!-- ~/.hobbies window -->
      <div id="win-hobbies" class="win win-hobbies" data-win data-no-restore>
        <div class="win-header">
          <div class="win-dots">
            <div class="dot r"></div><div class="dot y"></div><div class="dot g"></div>
          </div>
          <div class="win-title">~/.hobbies</div>
        </div>
        <div class="win-body" style="padding:8px 18px 18px">
          <ul>
            <li><span class="hk">[01]</span> cooking <span>weekly</span></li>
            <li><span class="hk">[02]</span> cars <span>obsession</span></li>
            <li><span class="hk">[03]</span> astronomy <span>clear nights</span></li>
            <li><span class="hk">[04]</span> coffee <span>twice daily</span></li>
            <li><span class="hk">[05]</span> music <span>always</span></li>
          </ul>
        </div>
      </div>

      <!-- stats.txt window -->
      <div id="win-stats" class="win win-stats" data-win data-no-restore>
        <div class="win-header">
          <div class="win-dots">
            <div class="dot r"></div><div class="dot y"></div><div class="dot g"></div>
          </div>
          <div class="win-title">stats.txt</div>
        </div>
        <div class="win-body">
          <div class="stat-row"><span class="k">years coding</span><span class="v">5+</span></div>
          <div class="stat-row"><span class="k">years pro</span><span class="v">2+</span></div>
          <div class="stat-row"><span class="k">degree</span><span class="v">M.Sc.</span></div>
          <div class="stat-row"><span class="k">timezone</span><span class="v">UTC+2</span></div>
          <div class="stat-row"><span class="k">coffee / day</span><span class="v">2.4 avg</span></div>
          <div class="stat-row"><span class="k">availability</span><span class="v">open</span></div>
        </div>
      </div>

      <!-- denis.config.json window -->
      <div id="win-config" class="win win-config" data-win data-no-restore>
        <div class="win-header">
          <div class="win-dots">
            <div class="dot r"></div><div class="dot y"></div><div class="dot g"></div>
          </div>
          <div class="win-title">denis.config.json</div>
        </div>
        <div class="win-body">
          <div class="cfg"><span class="p">{"{"}</span></div>
          <div class="cfg i"><span class="ck">"name"</span><span class="p">: </span><span class="cs">"Leonte Denis"</span><span class="p">,</span></div>
          <div class="cfg i"><span class="ck">"location"</span><span class="p">: </span><span class="cs">"Romania"</span><span class="p">,</span></div>
          <div class="cfg i"><span class="ck">"company"</span><span class="p">: </span><span class="cs">".msg Systems"</span><span class="p">,</span></div>
          <div class="cfg i"><span class="ck">"project"</span><span class="p">: </span><span class="cs">"Mercedes-Benz Group"</span><span class="p">,</span></div>
          <div class="cfg i"><span class="ck">"languages"</span><span class="p">: [</span><span class="cs">"java"</span><span class="p">, </span><span class="cs">"ts"</span><span class="p">, </span><span class="cs">"python"</span><span class="p">],</span></div>
          <div class="cfg i"><span class="ck">"open_to_chat"</span><span class="p">: </span><span class="cb">true</span></div>
          <div class="cfg"><span class="p">{"}"}</span></div>
          <div class="cfg" style="margin-top:10px"><span class="cc">// last edited may 2026</span></div>
        </div>
      </div>

      <!-- now playing window -->
      <div id="win-now" class="win win-now" data-win data-no-restore>
        <div class="win-header">
          <div class="win-dots">
            <div class="dot r"></div><div class="dot y"></div><div class="dot g"></div>
          </div>
          <div class="win-title">now playing</div>
        </div>
        <div class="win-body">
          <div class="now-track">
            <div class="now-album"></div>
            <div class="now-info">
              <div class="now-t">Late Night Compile</div>
              <div class="now-a">Lo-fi Beats · for shipping</div>
            </div>
          </div>
          <div class="now-bar"></div>
        </div>
      </div>

      <div class="desktop-statusbar">
        <div class="desktop-statusbar-left">
          <span class="desktop-statusbar-dot"></span>
          <span>Denis OS</span>
          <span id="hint-count-bar"></span>
        </div>
        <time id="desktop-clock" aria-live="polite"></time>
      </div>

      <div id="bugs-toast" class="bugs-toast" aria-live="polite"></div>

      <!-- work.log window (spawned by WORK icon) -->
      <div id="win-work" class="win win-work" data-win data-no-restore style="display:none">
        <div class="win-header" aria-label="Drag window">
          <div class="win-dots">
            <div class="dot r"></div><div class="dot y"></div><div class="dot g"></div>
          </div>
          <div class="win-title">work.log</div>
        </div>
        <div class="win-body">
          <div class="wl-row"><span class="wl-k">role</span><span class="wl-v">full-stack engineer</span></div>
          <div class="wl-row"><span class="wl-k">company</span><span class="wl-v">.msg Systems Romania</span></div>
          <div class="wl-row"><span class="wl-k">client</span><span class="wl-v">Mercedes-Benz Group</span></div>
          <div class="wl-row"><span class="wl-k">stack</span><span class="wl-v">Spring Boot · Angular</span></div>
          <div class="wl-row"><span class="wl-k"></span><span class="wl-v">Docker · PostgreSQL</span></div>
          <div class="wl-row"><span class="wl-k">exp</span><span class="wl-v">2+ years</span></div>
          <div class="wl-sep"></div>
          <a href="#projects" class="wl-link">see all projects ↗</a>
        </div>
      </div>
    </div>

    <div class="desktop-hint">
      <span>tip: drag the windows around ⤬</span>
      <span id="hint-count"></span>
    </div>
  </div>
</section>

<style>
  #desktop {
    background: var(--bg);
    padding: 120px 32px;
    position: relative;
    z-index: 1;
    min-height: 100dvh;
  }

  .section-inner { max-width: 1400px; margin: 0 auto; }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 80px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .section-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .section-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-tag::before { content: '— '; opacity: 0.5; }
  .section-title {
    font-family: var(--sans);
    font-size: clamp(28px, 4vw, 60px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .section-title em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }

  /* Desktop board */
  .desktop-board {
    position: relative;
    height: 880px;
    border: 1px solid var(--line-strong);
    background:
      linear-gradient(rgba(235,233,228,0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(235,233,228,0.055) 1px, transparent 1px),
      var(--bg2);
    background-size: 24px 24px, 24px 24px, auto;
    box-shadow: 0 0 0 1px var(--line), 0 24px 80px rgba(0,0,0,0.25);
    overflow: hidden;
    max-width: 1400px;
    margin: 0 auto;
  }

  .desktop-statusbar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 28px;
    background: var(--bg3);
    border-top: 1px solid var(--line-strong);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    user-select: none;
    z-index: 200;
  }
  .desktop-statusbar-left { display: flex; align-items: center; gap: 16px; }
  .desktop-statusbar-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 6px var(--green);
    animation: blink-dot 1.4s ease-in-out infinite;
  }

  /* Icons */
  .desktop-icon {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    cursor: pointer;
    user-select: none;
    width: 80px;
    text-align: center;
    transition: color 0.15s;
  }
  .desktop-icon:hover, .desktop-icon:focus { color: var(--green); outline: none; }
  .desktop-icon-img {
    width: 48px; height: 48px;
    border: 1px solid var(--line-strong);
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    color: var(--text);
    background: var(--bg2);
  }

  /* Windows */
  .win {
    position: absolute;
    background: var(--bg2);
    border: 1px solid var(--line-strong);
    box-shadow: 8px 8px 0 rgba(0,0,0,0.4), 0 0 60px rgba(0,0,0,0.3);
    font-family: var(--mono);
    font-size: 12px;
    transition: box-shadow 0.2s;
  }
  .win:hover {
    box-shadow: 10px 10px 0 rgba(0,0,0,0.5), 0 0 80px oklch(0.82 0.22 145 / 0.15);
  }

  .win-header {
    background: var(--bg3);
    border-bottom: 1px solid var(--line-strong);
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-dim);
    cursor: move;
    user-select: none;
  }
  .win-dots { display: flex; gap: 5px; margin-right: 8px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.r { background: oklch(0.7 0.22 25); }
  .dot.y { background: oklch(0.78 0.16 85); }
  .dot.g { background: oklch(0.78 0.18 145); }
  .win-title { font-size: 11px; color: var(--text); flex: 1; letter-spacing: 0.05em; }
  .dot.r { cursor: pointer; }
  .dot.r:hover { filter: brightness(1.3); }
  .win-body {
    padding: 18px;
    color: var(--text-dim);
    line-height: 1.7;
  }

  /* About window */
  .win-about { top: 60px; left: 60px; width: 480px; z-index: 3; }
  .win-hi {
    font-family: var(--serif);
    font-style: italic;
    font-size: 36px;
    color: var(--green);
    line-height: 1;
    margin-bottom: 14px;
    font-weight: 400;
  }
  .win-about .win-body p { margin-bottom: 12px; font-size: 12px; color: var(--text); line-height: 1.65; font-family: var(--sans); }
  .win-about .win-body p:last-of-type { margin-bottom: 0; }
  .win-about strong { color: var(--green); font-weight: 600; }
  .win-links { margin-top: 18px; display: flex; gap: 12px; flex-wrap: wrap; }
  .win-links a {
    font-family: var(--mono); font-size: 10px;
    color: var(--text-dim); text-decoration: none;
    padding: 6px 10px; border: 1px solid var(--line);
    letter-spacing: 0.08em; transition: all 0.15s;
  }
  .win-links a:hover { border-color: var(--green); color: var(--green); }

  /* Hobbies window */
  .win-hobbies { top: 60px; right: 60px; width: 340px; z-index: 2; }
  .win-hobbies ul { list-style: none; }
  .win-hobbies li {
    padding: 10px 0; display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed var(--line);
    font-size: 12px; color: var(--text);
  }
  .win-hobbies li:last-child { border-bottom: 0; }
  .win-hobbies li span { color: var(--text-faint); }
  .hk { color: var(--green); font-family: var(--mono); margin-right: 8px; font-size: 10px; }

  /* Stats window */
  .win-stats { top: 420px; left: 100px; width: 360px; z-index: 2; }
  .stat-row {
    display: flex; justify-content: space-between;
    padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 11px;
  }
  .stat-row:last-child { border: 0; }
  .stat-row .k { color: var(--text-faint); letter-spacing: 0.05em; }
  .stat-row .v { color: var(--green); }

  /* Config window */
  .win-config { top: 350px; right: 80px; width: 420px; z-index: 1; }
  .cfg { line-height: 1.85; font-size: 11px; }
  .cfg.i { padding-left: 16px; }
  .ck { color: oklch(0.78 0.18 200); }
  .cs { color: oklch(0.85 0.12 70); }
  .cb { color: var(--red); }
  .cn { color: var(--green); }
  .p  { color: var(--text-faint); }
  .cc { color: rgba(235,233,228,0.25); font-style: italic; }

  /* Now playing */
  .win-now { top: 660px; left: 480px; width: 280px; z-index: 4; }
  .now-track { display: flex; gap: 12px; align-items: center; }
  .now-album {
    width: 48px; height: 48px;
    background: linear-gradient(135deg, var(--green), var(--blue));
    flex-shrink: 0;
  }
  .now-info { display: flex; flex-direction: column; gap: 2px; overflow: hidden; }
  .now-t { font-family: var(--sans); font-size: 12px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .now-a { font-size: 10px; color: var(--text-faint); }
  .now-bar { margin-top: 12px; height: 2px; background: var(--line); position: relative; }
  .now-bar::after {
    content: ''; position: absolute;
    left: 0; top: 0; bottom: 0; width: 35%;
    background: var(--green);
    animation: progress 8s linear infinite;
  }
  @keyframes progress { from{width:0} to{width:100%} }

  /* Work window */
  .win-work { top: 180px; left: 200px; width: 380px; z-index: 5; }
  .wl-row {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 7px 0; border-bottom: 1px dashed var(--line); font-size: 11px;
  }
  .wl-row:last-of-type { border-bottom: 0; }
  .wl-k { color: var(--text-faint); letter-spacing: 0.05em; min-width: 72px; }
  .wl-v { color: var(--text); text-align: right; }
  .wl-sep { height: 1px; background: var(--line-strong); margin: 12px 0 10px; }
  .wl-link {
    display: inline-block; font-family: var(--mono); font-size: 10px;
    color: var(--green); text-decoration: none; letter-spacing: 0.08em;
    padding: 5px 10px; border: 1px solid var(--green);
    transition: background 0.15s, color 0.15s;
  }
  .wl-link:hover { background: var(--green); color: var(--bg); }

  .bugs-toast {
    position: absolute;
    bottom: 24px; left: 50%; transform: translateX(-50%) translateY(12px);
    background: var(--bg3); border: 1px solid var(--green);
    font-family: var(--mono); font-size: 11px; color: var(--green);
    padding: 10px 18px; letter-spacing: 0.08em;
    opacity: 0; transition: opacity 0.2s, transform 0.2s;
    pointer-events: none; white-space: nowrap; z-index: 100;
  }
  .bugs-toast.show {
    opacity: 1; transform: translateX(-50%) translateY(0);
  }

  .desktop-hint {
    display: flex; justify-content: space-between;
    margin-top: 16px;
    font-family: var(--mono); font-size: 10px;
    color: var(--text-faint); letter-spacing: 0.1em; text-transform: uppercase;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .section-head { grid-template-columns: 1fr; gap: 24px; }
    .desktop-board {
      height: auto;
      overflow: visible;
      background: none;
      border: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 0;
    }
    .win {
      position: relative !important;
      top: auto !important; left: auto !important;
      right: auto !important; bottom: auto !important;
      width: 100% !important;
      z-index: auto !important;
    }
    .desktop-icon { display: none; }
  }
  @media (max-width: 720px) {
    #desktop { padding: 80px 16px; }
    .win-about .win-hi { font-size: 28px; }
  }
</style>

<script>
  const isTouchOnly = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  let zCounter = 10;

  const allWins = () => Array.from(document.querySelectorAll<HTMLElement>('[data-win]'));
  const updateCount = () => {
    const total = allWins().length;
    const open  = allWins().filter(w => w.style.display !== 'none').length;
    const el = document.getElementById('hint-count');
    if (el) el.textContent = `${open} / ${total} files open`;
    const bar = document.getElementById('hint-count-bar');
    if (bar) bar.textContent = `${open} / ${total} open`;
  };

  const updateClock = () => {
    const el = document.getElementById('desktop-clock');
    if (!el) return;
    const now = new Date();
    el.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  };
  updateClock();
  setInterval(updateClock, 10000);

  const spawnWin = (w: HTMLElement) => {
    if (w.style.display === 'none') {
      w.style.display = '';
      w.style.transform = 'scale(0.85)';
      w.style.opacity = '0';
      w.style.transition = 'transform 0.2s, opacity 0.2s';
      zCounter++;
      w.style.zIndex = String(zCounter);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        w.style.transform = '';
        w.style.opacity = '';
        updateCount();
      }));
    } else {
      zCounter++;
      w.style.zIndex = String(zCounter);
    }
  };

  // Window dragging + close — desktop only
  if (!isTouchOnly) document.querySelectorAll('[data-win]').forEach(win => {
    const w = win as HTMLElement;
    const header = w.querySelector('.win-header') as HTMLElement;
    const closeBtn = w.querySelector('.dot.r') as HTMLElement;

    let dragging = false;
    let startX = 0, startY = 0, origX = 0, origY = 0;

    header?.addEventListener('mousedown', (e: MouseEvent) => {
      if ((e.target as Element).classList.contains('r')) return;
      dragging = true;
      zCounter++;
      w.style.zIndex = String(zCounter);
      const r = w.getBoundingClientRect();
      const board = document.getElementById('desktop-board')!.getBoundingClientRect();
      origX = r.left - board.left;
      origY = r.top - board.top;
      startX = e.clientX;
      startY = e.clientY;
      w.style.left = origX + 'px';
      w.style.top  = origY + 'px';
      w.style.right = 'auto';
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!dragging) return;
      const board = document.getElementById('desktop-board')!.getBoundingClientRect();
      const statusBarH = 28;
      const newX = origX + (e.clientX - startX);
      const newY = origY + (e.clientY - startY);
      const maxX = board.width  - w.offsetWidth;
      const maxY = board.height - w.offsetHeight - statusBarH;
      w.style.left = Math.max(0, Math.min(newX, maxX)) + 'px';
      w.style.top  = Math.max(0, Math.min(newY, maxY)) + 'px';
    });

    window.addEventListener('mouseup', () => { dragging = false; });

    closeBtn?.addEventListener('click', () => {
      w.style.transition = 'transform 0.2s, opacity 0.2s';
      w.style.transform = 'scale(0.8)';
      w.style.opacity = '0';
      setTimeout(() => {
        w.style.display = 'none';
        w.style.transform = '';
        w.style.opacity = '';
        w.style.transition = '';
        updateCount();
      }, 200);
    });
  });

  // Window-spawning icons (data-spawns)
  document.querySelectorAll<HTMLElement>('.desktop-icon[data-spawns]').forEach(icon => {
    const winId = icon.dataset.spawns!;
    const trigger = () => {
      const win = document.getElementById(winId) as HTMLElement | null;
      if (win) spawnWin(win);
    };
    icon.addEventListener('click', trigger);
    icon.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); trigger(); }
    });
  });

  // Utility icons (data-icon: resume, bugs)
  document.querySelectorAll<HTMLElement>('.desktop-icon[data-icon]').forEach(icon => {
    const action = icon.dataset.icon;
    const trigger = () => {
      if (action === 'resume') {
        const a = document.createElement('a');
        a.href = '/resume.pdf'; a.download = 'resume.pdf';
        a.click();
      } else if (action === 'bugs') {
        const toast = document.getElementById('bugs-toast')!;
        toast.textContent = '> 0 bugs found. (trust me.)';
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 3000);
      }
    };
    icon.addEventListener('click', trigger);
    icon.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); trigger(); }
    });
  });

  updateCount();
</script>
