---
interface Props {
  templateName: string;
  slug: string;
}

const { templateName, slug } = Astro.props;
---

<div class="demo-bar" role="banner" aria-label="Template demo bar" data-template={slug}>
  <a href="/showcase" class="demo-bar__back" aria-label="Back to Showcase">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span data-i18n="nav.showcase">Showcase</span>
  </a>

  <div class="demo-bar__badge" aria-label={`Breadcrumb: Home, Showcase, ${templateName}`}>
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/showcase" data-i18n="nav.showcase">Showcase</a>
    <span aria-hidden="true">/</span>
    <strong>{templateName}</strong>
  </div>

  <a href="/contact" class="demo-bar__cta" aria-label="Contact Leonte Denis">
    <span data-i18n="showcase.demoBar.cta">Like this? Let's talk</span>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M5 2L10 7L5 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</div>

<style>
  .demo-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    background: rgba(231, 237, 235, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(105, 164, 129, 0.25);
    font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
    font-size: 13px;
    letter-spacing: 0.03em;
  }

  :global(html.dark) .demo-bar {
    background: rgba(8, 8, 8, 0.92);
    border-bottom-color: rgba(0, 255, 65, 0.2);
  }

  .demo-bar__back,
  .demo-bar__cta {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #334155;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  :global(html.dark) .demo-bar__back,
  :global(html.dark) .demo-bar__cta {
    color: rgba(255, 255, 255, 0.55);
  }

  .demo-bar__back:hover,
  .demo-bar__cta:hover {
    color: #4D8260;
  }

  :global(html.dark) .demo-bar__back:hover,
  :global(html.dark) .demo-bar__cta:hover {
    color: #00ff41;
  }

  .demo-bar__badge {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #475569;
    font-size: 12px;
    text-align: center;
  }

  :global(html.dark) .demo-bar__badge {
    color: rgba(255, 255, 255, 0.4);
  }

  .demo-bar__badge strong {
    color: #1e293b;
    font-weight: 600;
  }

  :global(html.dark) .demo-bar__badge strong {
    color: rgba(255, 255, 255, 0.7);
  }
  .demo-bar__badge a { color: inherit; text-decoration: none; }
  .demo-bar__badge a:hover, .demo-bar__badge a:focus-visible { color: #4D8260; }
  :global(html.dark) .demo-bar__badge a:hover,
  :global(html.dark) .demo-bar__badge a:focus-visible { color: #00ff41; }

  @media (max-width: 480px) {
    .demo-bar__badge {
      display: none;
    }

    .demo-bar__cta {
      font-size: 12px;
    }
  }
</style>
