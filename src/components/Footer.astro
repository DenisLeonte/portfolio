---
import profile from '../data/profile.json';
import pkg from '../../package.json';
const [major, minor] = pkg.version.split('.');
const displayVersion = `v${major}.${minor}`;
---

<footer>
  <div class="footer-col">
    <strong>denis.exe</strong>
    <a href="#hero">↑ top</a>
    <a href="#projects">work</a>
    <a href="/contact">contact</a>
  </div>
  <div class="footer-col">
    <strong>elsewhere</strong>
    <a href={profile.socialLinks.github} target="_blank" rel="noopener">github ↗</a>
    <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener">linkedin ↗</a>
    <a href="/tech">colophon ↗</a>
  </div>
  <div class="footer-col">
    <strong>local time</strong>
    <span id="footer-time" class="footer-green">--:--:--</span>
    <div class="footer-dim">Cluj-Napoca, RO</div>
  </div>
  <div class="footer-col">
    <strong>status</strong>
    <span class="footer-green">● open for work</span>
    <div class="footer-dim">replies within 24h</div>
  </div>

  <div class="footer-mega">
    <div>© 2026 — {profile.name}. Crafted in Cluj.</div>
    <div>{displayVersion} · desktop remix</div>
  </div>
</footer>

<style>
  footer {
    padding: 32px 32px 24px;
    background: var(--bg);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  .footer-col strong {
    color: var(--text);
    display: block;
    margin-bottom: 8px;
    font-weight: 400;
  }
  .footer-col a, .footer-col span, .footer-col div {
    display: block;
    padding: 2px 0;
  }
  .footer-col a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-col a:hover { color: var(--green); }

  .footer-green { color: var(--green); }
  .footer-dim { color: var(--text-faint); margin-top: 4px; }

  .footer-mega {
    grid-column: 1 / -1;
    border-top: 1px solid var(--line);
    margin-top: 24px;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-faint);
  }

  @media (max-width: 768px) {
    footer { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    footer { grid-template-columns: 1fr; padding: 24px 16px; }
  }
</style>

<script>
  function tickFooter() {
    const el = document.getElementById('footer-time');
    if (el) el.textContent = new Date().toLocaleTimeString('en-GB', { hour12: false });
  }
  tickFooter();
  setInterval(tickFooter, 1000);
</script>
