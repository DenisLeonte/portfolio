---
import profile from '../data/profile.json';
const buildId = import.meta.env.PUBLIC_BUILD_SHA?.slice(0, 7) ?? 'local';
---

<footer>
  <div class="footer-col">
    <strong>denis.exe</strong>
    <a href="#hero" data-i18n="footer.top">↑ top</a>
    <a href="#projects" data-i18n="footer.work">work</a>
    <a href="/contact" data-i18n="footer.contact">contact</a>
  </div>
  <div class="footer-col">
    <strong data-i18n="footer.elsewhere">elsewhere</strong>
    <a href={profile.socialLinks.github} target="_blank" rel="noopener" data-i18n="footer.github">github ↗</a>
    <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener" data-i18n="footer.linkedin">linkedin ↗</a>
    <a href="/tech" data-i18n="footer.colophon">colophon ↗</a>
  </div>
  <div class="footer-col">
    <strong data-i18n="footer.localTime">local time</strong>
    <span id="footer-time" class="footer-green">--:--:--</span>
    <div class="footer-dim">Cluj-Napoca, RO</div>
  </div>
  <div class="footer-col">
    <strong data-i18n="footer.status">status</strong>
    <span class="footer-green" data-i18n="footer.openForWork">● open for work</span>
    <div class="footer-dim" data-i18n="footer.repliesWithin">replies within 24h</div>
  </div>

  <div class="footer-mega">
    <div>© 2026 — {profile.name}. <span data-i18n="footer.craftedIn">Crafted in Cluj.</span></div>
    <div>build {buildId} · desktop remix</div>
  </div>
</footer>

<style>
  footer {
    padding: 32px 32px calc(24px + env(safe-area-inset-bottom));
    background: var(--bg);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  .footer-col strong {
    color: var(--text);
    display: block;
    margin-bottom: 8px;
    font-weight: 400;
  }
  .footer-col a, .footer-col span, .footer-col div {
    display: block;
    padding: 2px 0;
  }
  .footer-col a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
    touch-action: manipulation;
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .footer-col a:hover,
  .footer-col a:active { color: var(--green); }

  .footer-green { color: var(--green); }
  .footer-dim { color: var(--text-faint); margin-top: 4px; }

  .footer-mega {
    grid-column: 1 / -1;
    border-top: 1px solid var(--line);
    margin-top: 24px;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-faint);
  }

  @media (max-width: 768px) {
    footer { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    footer { grid-template-columns: 1fr; padding: 24px 16px calc(24px + env(safe-area-inset-bottom)); }
  }
</style>

<script>
  function tickFooter() {
    const el = document.getElementById('footer-time');
    if (el) {
      el.textContent = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Bucharest',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(new Date());
    }
  }
  tickFooter();
  setInterval(tickFooter, 1000);
</script>
