---
import profile from '../data/profile.json';
import pkg from '../../package.json';
const [major, minor] = pkg.version.split('.');
const displayVersion = `v${major}.${minor}`;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const homeAnchor = (hash: string) => isHome ? hash : `/${hash}`;
---

<footer>
  <div class="footer-col">
    <strong>denis.exe</strong>
    <a href={homeAnchor('#hero')} data-i18n="footer.top">↑ top</a>
    <a href={homeAnchor('#projects')} data-i18n="footer.work">work</a>
    <a href="/contact" data-i18n="footer.contact">contact</a>
    <a href="/privacy" data-i18n="footer.privacy">privacy</a>
  </div>
  <div class="footer-col">
    <strong data-i18n="footer.elsewhere">elsewhere</strong>
    <a href={profile.socialLinks.github} target="_blank" rel="noopener" data-i18n="footer.github">github ↗</a>
    <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener" data-i18n="footer.linkedin">linkedin ↗</a>
    <a href="/tech" data-i18n="footer.colophon">colophon ↗</a>
  </div>
  <div class="footer-col">
    <strong data-i18n="footer.localTime">local time</strong>
    <span id="footer-time" class="footer-green">--:--:--</span>
    <div class="footer-dim">Cluj-Napoca, RO</div>
  </div>
  <div class="footer-col">
    <strong data-i18n="footer.status">status</strong>
    <span class="footer-green" data-i18n="footer.openForWork">● open for work</span>
    <div class="footer-dim" data-i18n="footer.repliesWithin">replies within 2 business days</div>
  </div>

  <div class="footer-mega">
    <div>© 2026 — {profile.name}. <span data-i18n="footer.craftedIn">Crafted in Cluj.</span></div>
    <div>{displayVersion} · desktop remix</div>
  </div>
</footer>

<style>
  footer {
    padding: 32px 32px calc(24px + env(safe-area-inset-bottom));
    background: var(--bg);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  .footer-col strong {
    color: var(--text);
    display: block;
    margin-bottom: 8px;
    font-weight: 400;
  }
  .footer-col a, .footer-col span, .footer-col div {
    display: block;
    padding: 2px 0;
  }
  .footer-col a {
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
    touch-action: manipulation;
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .footer-col a:hover,
  .footer-col a:active { color: var(--green); }

  .footer-green { color: var(--green); }
  .footer-dim { color: var(--text-faint); margin-top: 4px; }

  .footer-mega {
    grid-column: 1 / -1;
    border-top: 1px solid var(--line);
    margin-top: 24px;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-faint);
  }

  @media (max-width: 768px) {
    footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 28px;
    }
  }
  @media (max-width: 480px) {
    footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 28px 16px calc(20px + env(safe-area-inset-bottom));
      column-gap: 20px;
      row-gap: 24px;
      letter-spacing: 0.08em;
    }
    .footer-col { min-width: 0; }
    .footer-col strong { margin-bottom: 10px; }
    .footer-col a {
      min-height: 28px;
      padding: 0;
    }
    .footer-col:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      padding-top: 20px;
    }
    .footer-dim {
      line-height: 1.6;
      overflow-wrap: anywhere;
    }
    .footer-mega {
      margin-top: 0;
      padding-top: 18px;
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      line-height: 1.6;
    }
  }
</style>

<script>
  function tickFooter() {
    const el = document.getElementById('footer-time');
    if (el) el.textContent = new Date().toLocaleTimeString('en-GB', { hour12: false });
  }
  tickFooter();
  setInterval(tickFooter, 1000);
</script>
