---
import skillsData from '../data/skills.json';

// Flatten all skills into a single ranked list (exclude spoken languages)
const allSkills = skillsData.categories
  .filter(cat => cat.name !== 'Languages')
  .flatMap(cat => cat.skills.map(s => ({ name: s.name, cat: cat.name, pct: s.level })))
  .sort((a, b) => b.pct - a.pct);
---

<section id="skills">
  <div class="section-inner">
    <div class="section-head">
      <div class="meta">
        <div class="section-num">02 / skills</div>
        <div class="section-tag" data-i18n="skills.sectionTag">stack</div>
      </div>
      <h2 class="section-title" data-i18n-html="skills.sectionTitle">
        Things I <em>actually</em> ship with.
      </h2>
    </div>

    <div class="skills-list" id="skills-list">
      {allSkills.map((skill, i) => (
        <div class="skill-row">
          <div class="skill-num">{String(i + 1).padStart(2, '0')}</div>
          <div class="skill-name">{skill.name}</div>
          <div class="skill-cat">{skill.cat}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #skills {
    background: var(--bg2);
    padding: 120px 32px;
    position: relative;
    z-index: 1;
  }

  .section-inner { max-width: 1400px; margin: 0 auto; }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 80px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .section-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .section-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-tag::before { content: '— '; opacity: 0.5; }
  .section-title {
    font-family: var(--sans);
    font-size: clamp(28px, 4vw, 60px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0;
  }
  .section-title em, .section-title :global(em) {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }

  /* Skills list */
  .skills-list { display: flex; flex-direction: column; }

  .skill-row {
    display: grid;
    grid-template-columns: 60px 1fr 240px;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    transition: padding 0.3s, background 0.2s;
    cursor: default;
  }
  .skill-row:last-child { border-bottom: 1px solid var(--line); }
  .skill-row:hover { padding-left: 16px; }

  .skill-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
  }
  .skill-name {
    font-family: var(--sans);
    font-size: clamp(18px, 2.4vw, 32px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
    transition: color 0.2s;
  }
  .skill-row:hover .skill-name { color: var(--green); }

  .skill-cat {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 1100px) {
    .section-head { grid-template-columns: 1fr; gap: 24px; }
    .skill-row { grid-template-columns: 40px 1fr 180px; }
  }
  @media (max-width: 720px) {
    #skills { padding: 80px 16px; }
    .skill-row { grid-template-columns: 40px 1fr; gap: 12px; padding: 18px 0; }
    .skill-cat { display: none; }
    .skill-name { font-size: 18px; }
  }
  @media (max-width: 420px) {
    .skill-num { display: none; }
    .skill-row { grid-template-columns: 1fr; }
  }
</style>
