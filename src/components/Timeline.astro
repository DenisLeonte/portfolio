---
import experience from '../data/experience.json';

// Sort: work on top, then by start date desc
const sorted = [...experience].sort((a, b) => {
  if (a.endDate === 'Present') return -1;
  if (b.endDate === 'Present') return 1;
  // Education sorted newer first
  const aYear = parseInt(a.startDate.split('/')[1], 10);
  const bYear = parseInt(b.startDate.split('/')[1], 10);
  return bYear - aYear;
});

function formatDate(d: string) {
  if (d === 'Present') return 'Now';
  const [m, y] = d.split('/');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return `${months[parseInt(m,10) - 1]} ${y}`;
}
---

<section id="experience">
  <div class="section-inner">
    <div class="section-head">
      <div class="meta">
        <div class="section-num">04 / career</div>
        <div class="section-tag">timeline</div>
      </div>
      <h2 class="section-title">
        The <em>path</em>, from algebra hall to enterprise stack.
      </h2>
    </div>

    <div class="timeline">
      {sorted.map(entry => (
        <div class="timeline-row">
          <div class="tl-date">
            <span class={`tl-dot ${entry.type}`}></span>
            {formatDate(entry.startDate)} — {formatDate(entry.endDate)}
          </div>
          <div class="tl-info">
            <div class="tl-company">{entry.company}</div>
            <div class="tl-role timeline-role" data-entry-id={entry.id}>{entry.role}</div>
            <span class={`tl-type ${entry.type}`}>
              {entry.type === 'work' ? '// work' : '// education'}
            </span>
          </div>
          <div class="tl-desc timeline-desc" data-entry-id={entry.id}>
            {entry.description}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #experience {
    background: var(--bg2);
    padding: 120px 32px;
    position: relative;
    z-index: 1;
  }

  .section-inner { max-width: 1400px; margin: 0 auto; }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 80px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .section-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .section-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-tag::before { content: '— '; opacity: 0.5; }
  .section-title {
    font-family: var(--sans);
    font-size: clamp(28px, 4vw, 60px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0;
  }
  .section-title em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }

  /* Timeline rows */
  .timeline { display: flex; flex-direction: column; }

  .timeline-row {
    display: grid;
    grid-template-columns: 180px 1fr 1fr;
    gap: 60px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
    align-items: start;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s, transform 0.6s;
  }
  .timeline-row.visible { opacity: 1; transform: translateY(0); }
  .timeline-row:last-child { border-bottom: 1px solid var(--line); }

  .tl-date {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.08em;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding-top: 4px;
  }
  .tl-dot {
    display: inline-block;
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 3px;
  }
  .tl-dot.work { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .tl-dot.education { background: var(--warm); box-shadow: 0 0 6px var(--warm); }

  .tl-company {
    font-family: var(--sans);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 500;
    margin-bottom: 4px;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .tl-role {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--green);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .tl-type {
    display: inline-block;
    font-family: var(--mono);
    font-size: 9px;
    padding: 2px 8px;
    border: 1px solid var(--line);
    color: var(--text-dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tl-type.work { border-color: var(--green); color: var(--green); }
  .tl-type.education { border-color: oklch(0.62 0.27 265); color: oklch(0.62 0.27 265); }

  .tl-desc {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
  }

  @media (max-width: 1100px) {
    .section-head { grid-template-columns: 1fr; gap: 24px; }
    .timeline-row { grid-template-columns: 1fr; gap: 12px; padding: 32px 0; }
  }
  @media (max-width: 720px) {
    #experience { padding: 80px 16px; }
    .tl-company { font-size: 20px; }
    .timeline-row { gap: 8px; padding: 24px 0; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const rows = document.querySelectorAll('.timeline-row');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });
    rows.forEach(r => io.observe(r));
  });
</script>
