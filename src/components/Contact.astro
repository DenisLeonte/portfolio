---
import profile from '../data/profile.json';
import ContactForm from './ContactForm.tsx';

const hasEmailJS = !!(
  import.meta.env.PUBLIC_EMAILJS_SERVICE_ID &&
  import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID &&
  import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY
);
---

<section id="contact-page">
  <div class="contact-inner">
    <div class="section-head">
      <div class="meta">
        <div class="section-num">05 / contact</div>
        <div class="section-tag" data-i18n="contact.sectionTag">send a signal</div>
      </div>
      <h1 class="section-title">
        <span data-i18n-html="contact.talkTitle1">Let's <em>talk.</em></span><br>
        <span class="title-outline" data-i18n="contact.talkTitle2">Send a signal.</span>
      </h1>
    </div>

    <div class="contact-body">
      <!-- Form column -->
      <div class="form-col">
        <div class="form-label" data-i18n="contact.formLabel">// compose_message</div>

        {!hasEmailJS ? (
          <div class="form-placeholder">
            <p class="placeholder-text" data-i18n="contact.configureEmailJS">Configure EmailJS to enable the contact form.</p>
            <p class="placeholder-sub" data-i18n-html="contact.configureEmailJSSub">Copy <code>.env.example</code> → <code>.env</code> and add your credentials.</p>
          </div>
        ) : (
          <ContactForm client:visible />
        )}
        <p class="form-privacy">
          <span data-i18n="contact.privacyNotice">Your name, email address, and message are used only to reply to this inquiry.</span>{' '}
          <a href="/privacy" data-i18n="contact.privacyLink">Read the privacy policy</a>.
        </p>
      </div>

      <!-- Info column -->
      <div class="info-col">
        <div class="info-label" data-i18n="contact.directChannels">// direct_channels</div>

        <div class="channels">
          {profile.email && !profile.email.startsWith('[') && (
            <a class="channel" href={`mailto:${profile.email}`}>
              <div>
                <div class="channel-name" data-i18n="contact.channelEmail">Email</div>
                <div class="channel-sub">{profile.email}</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
          )}

          {profile.socialLinks.linkedin && !profile.socialLinks.linkedin.startsWith('[') && (
            <a class="channel" href={profile.socialLinks.linkedin} target="_blank" rel="noopener">
              <div>
                <div class="channel-name" data-i18n="contact.channelLinkedIn">LinkedIn</div>
                <div class="channel-sub">/in/leontedenis</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
          )}

          {profile.socialLinks.github && !profile.socialLinks.github.startsWith('[') && (
            <a class="channel" href={profile.socialLinks.github} target="_blank" rel="noopener">
              <div>
                <div class="channel-name" data-i18n="contact.channelGitHub">GitHub</div>
                <div class="channel-sub">/DenisLeonte</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
          )}

          <a class="channel" href="/resume.pdf" target="_blank">
            <div>
              <div class="channel-name" data-i18n="contact.channelResume">Resume</div>
              <div class="channel-sub" data-i18n="contact.resumeSub">PDF, 1 page</div>
            </div>
            <div class="channel-arrow">↗</div>
          </a>
        </div>

        <div class="status-card">
          <div class="status-dot"></div>
          <div>
            <div class="status-title" data-i18n="contact.openTo">Open to opportunities</div>
            <div class="status-sub" data-i18n="contact.statusSub">Full-time, contract, or just a chat about distributed systems and espresso.</div>
          </div>
        </div>

        <div class="response-note" data-i18n="contact.responseTime">// You'll receive a personal reply within 2 business days.</div>
      </div>
    </div>
  </div>
</section>

<style>
  #contact-page {
    background: var(--bg);
    padding: 160px 32px 120px;
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }

  .contact-inner { max-width: 1400px; margin: 0 auto; }

  /* Header */
  .section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 80px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .section-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .section-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-tag::before { content: '— '; opacity: 0.5; }
  .section-title {
    font-family: var(--sans);
    font-size: clamp(40px, 7vw, 120px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }
  .section-title em, .section-title :global(em) {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }
  .title-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text);
  }

  /* Body layout */
  .contact-body {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 80px;
    border-top: 1px solid var(--line);
    padding-top: 60px;
  }

  /* Form column */
  .form-label,
  .info-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--green);
    letter-spacing: 0.1em;
    margin-bottom: 28px;
    opacity: 0.8;
  }
  .form-placeholder {
    border: 1px dashed var(--line-strong);
    padding: 40px;
    text-align: center;
  }
  .placeholder-text {
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .placeholder-sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
  }
  .placeholder-sub code {
    color: var(--green);
  }
  .form-privacy {
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1.7;
    color: var(--text-faint);
  }
  .form-privacy a { color: var(--green); text-decoration: none; }
  .form-privacy a:hover, .form-privacy a:focus-visible { text-decoration: underline; }

  /* Info column */
  .channels { display: flex; flex-direction: column; margin-bottom: 40px; }
  .channel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
    transition: padding 0.2s;
  }
  .channel:first-child { border-top: 1px solid var(--line); }
  .channel:hover { padding-left: 12px; }
  .channel-name {
    font-family: var(--sans);
    font-size: 18px;
    font-weight: 500;
  }
  .channel-sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.05em;
    margin-top: 4px;
  }
  .channel-arrow {
    font-family: var(--mono);
    font-size: 16px;
    color: var(--text-faint);
    transition: color 0.2s;
  }
  .channel:hover .channel-arrow { color: var(--green); }

  /* Status */
  .status-card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 20px;
    border: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .status-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
    flex-shrink: 0;
    margin-top: 5px;
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .status-title {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 4px;
  }
  .status-sub {
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.6;
  }
  .response-note {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }

  @media (max-width: 1100px) {
    .section-head { grid-template-columns: 1fr; gap: 24px; }
    .contact-body { grid-template-columns: 1fr; gap: 60px; }
  }
  @media (max-width: 720px) {
    #contact-page { padding: 100px 16px 80px; }
    .section-title { font-size: clamp(32px, 10vw, 60px); }
  }
</style>
