---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import profile from '../data/profile.json';
import en from '../i18n/en.json';
import ro from '../i18n/ro.json';
import it from '../i18n/it.json';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Leonte Denis — Full-Stack Software Engineer',
  description = 'Full-Stack Software Engineer with 2 years of experience. Spring Boot, React, Angular, AI & Big Data. Currently at Mercedes-Benz Group AG.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const allTranslations = JSON.stringify({ en, ro, it });
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- Theme + Language: read localStorage BEFORE paint to prevent FOUC -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        var h = document.documentElement;
        h.classList.remove('dark', 'light');
        if (t === 'dark')  h.classList.add('dark');
        if (t === 'light') h.classList.add('light');

        // Language detection
        var supported = ['en', 'ro', 'it'];
        var stored = localStorage.getItem('lang');
        if (!stored || supported.indexOf(stored) === -1) {
          var nav = (navigator.language || '').split('-')[0].toLowerCase();
          stored = supported.indexOf(nav) !== -1 ? nav : 'en';
          localStorage.setItem('lang', stored);
        }
        h.setAttribute('lang', stored);
        h.dataset.lang = stored;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Leonte Denis" />
    <meta name="keywords" content="Full-Stack Developer, Spring Boot, React, Angular, Java, Software Engineer, Portfolio" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Security Headers (meta-tag equivalents for static hosting) -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Font loaded via global.css @import -->

    <!-- View Transitions (page-to-page animations) -->
    <ViewTransitions />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": profile.name,
      "jobTitle": profile.title,
      "description": description,
      "url": String(canonicalURL),
      "email": profile.email,
      "sameAs": [profile.socialLinks.github, profile.socialLinks.linkedin].filter(Boolean),
    })} />
  </head>

  <body>
    <!-- Fixed background layers -->
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="bg-aurora" id="bg-aurora" aria-hidden="true"><div class="bg-aurora-3"></div></div>
    <div class="bg-sparkles" id="bg-sparkles" aria-hidden="true"><canvas id="sparkles-canvas"></canvas></div>
    <div class="bg-crosshatch" id="bg-crosshatch" aria-hidden="true"></div>
    <div class="bg-dots" id="bg-dots" aria-hidden="true"></div>
    <div class="bg-spotlight" id="bg-spotlight" aria-hidden="true"></div>
    <div class="bg-supernova" id="bg-supernova" aria-hidden="true"></div>

    <div class="scanlines" aria-hidden="true"></div>
    <div class="noise" aria-hidden="true"></div>

    <!-- Scroll progress bar -->
    <div id="scroll-progress" aria-hidden="true"></div>
    <!-- Theme sweep overlay -->
    <div id="theme-sweep" aria-hidden="true"></div>
    <slot />

    <!-- GSAP ScrollTrigger initialization (runs after DOM is ready) -->
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener('astro:page-load', () => {
        // Kill stale ScrollTriggers from the previous page
        ScrollTrigger.getAll().forEach((st) => st.kill());

        // Check for reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          document.querySelectorAll('.gsap-hidden, .timeline-item, .project-card').forEach((el) => {
            (el as HTMLElement).style.opacity = '1';
            (el as HTMLElement).style.transform = 'none';
          });
          return;
        }

        // ─── ABOUT SECTION ───────────────────────────────────────
        const aboutElements = document.querySelectorAll('#about .gsap-hidden');
        if (aboutElements.length) {
          gsap.to(aboutElements, {
            scrollTrigger: {
              trigger: '#about',
              start: 'top 75%',
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: 'power3.out',
          });
        }

        // ─── SKILLS SECTION ──────────────────────────────────────
        const skillsHeaders = document.querySelectorAll('#skills .gsap-hidden');
        if (skillsHeaders.length) {
          gsap.to(skillsHeaders, {
            scrollTrigger: { trigger: '#skills', start: 'top 75%' },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: 'power3.out',
          });
        }

        const skillCards = document.querySelectorAll('#skills .skill-card');
        if (skillCards.length) {
          gsap.to(skillCards, {
            scrollTrigger: {
              trigger: '#skills',
              start: 'top 75%',
            },
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.5,
            stagger: 0.08,
            ease: 'back.out(1.4)',
          });

          // Animate skill bars when visible
          ScrollTrigger.create({
            trigger: '#skills',
            start: 'top 60%',
            onEnter: () => {
              document.querySelectorAll('.skill-bar-fill').forEach((bar) => {
                (bar as HTMLElement).classList.add('animated');
              });
            },
          });
        }

        // ─── PROJECTS SECTION ────────────────────────────────────
        const projectsHeaders = document.querySelectorAll('#projects .gsap-hidden');
        if (projectsHeaders.length) {
          gsap.to(projectsHeaders, {
            scrollTrigger: { trigger: '#projects', start: 'top 75%' },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: 'power3.out',
          });
        }

        const projectCards = document.querySelectorAll('#projects .project-card');
        if (projectCards.length) {
          gsap.to(projectCards, {
            scrollTrigger: {
              trigger: '#projects',
              start: 'top 75%',
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.2,
            ease: 'power3.out',
          });
        }

        // ─── EXPERIENCE TIMELINE ─────────────────────────────────
        const experienceHeaders = document.querySelectorAll('#experience .gsap-hidden');
        if (experienceHeaders.length) {
          gsap.to(experienceHeaders, {
            scrollTrigger: { trigger: '#experience', start: 'top 75%' },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: 'power3.out',
          });
        }

        const timelineItems = document.querySelectorAll('#experience .timeline-item');
        if (timelineItems.length) {
          timelineItems.forEach((item, index) => {
            const isLeft = index % 2 === 0;
            gsap.set(item, { opacity: 0, x: isLeft ? -30 : 30 });
            gsap.to(item, {
              scrollTrigger: {
                trigger: item,
                start: 'top 80%',
              },
              opacity: 1,
              x: 0,
              duration: 0.8,
              ease: 'power3.out',
              delay: 0.1,
            });
          });
        }

        // ─── CONTACT SECTION ─────────────────────────────────────
        const contactElements = document.querySelectorAll('#contact .gsap-hidden');
        if (contactElements.length) {
          gsap.to(contactElements, {
            scrollTrigger: {
              trigger: '#contact',
              start: 'top 75%',
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: 'power3.out',
          });
        }

        // ─── CTA SECTION ─────────────────────────────────────────
        const ctaElements = document.querySelectorAll('#cta .gsap-hidden');
        if (ctaElements.length) {
          gsap.to(ctaElements, {
            scrollTrigger: {
              trigger: '#cta',
              start: 'top 75%',
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: 'power3.out',
          });
        }

        // ─── TECH REF SECTION ────────────────────────────────────
        const techRefElements = document.querySelectorAll('#tech-ref .gsap-hidden');
        if (techRefElements.length) {
          gsap.to(techRefElements, {
            scrollTrigger: {
              trigger: '#tech-ref',
              start: 'top 75%',
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: 'power3.out',
          });
        }

        // ─── PARALLAX BACKGROUNDS ────────────────────────────────
        const parallaxLayers = document.querySelectorAll('[data-parallax]');
        parallaxLayers.forEach((layer) => {
          const speed = parseFloat((layer as HTMLElement).dataset.parallax || '0.3');
          gsap.to(layer, {
            yPercent: speed * 100,
            ease: 'none',
            scrollTrigger: {
              trigger: layer,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          });
        });

        // ─── HASH SCROLL (cross-page navigation e.g. /showcase → /#contact) ─
        // Must run after all ScrollTriggers are registered so that
        // ScrollTrigger.refresh() doesn't displace the scroll position.
        const hash = window.location.hash;
        if (hash && /^#[a-zA-Z][\w-]*$/.test(hash)) {
          const target = document.getElementById(hash.slice(1));
          if (target) {
            ScrollTrigger.refresh();
            // Two rAFs ensure we execute after GSAP's synchronous refresh
            // has finished mutating the layout.
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                target.scrollIntoView({ behavior: 'smooth' });
              });
            });
          }
        }
      });
    </script>

    <!-- i18n: embed translations and apply on load -->
    <script id="i18n-data" type="application/json" set:html={allTranslations} />
    <script>
      // ─── i18n: Client-side translation engine ───────────────────
      const LANG_KEY = 'lang';
      const SUPPORTED = ['en', 'ro', 'it'] as const;
      type Lang = (typeof SUPPORTED)[number];
      const BTN_WIDTH = 28; // px — matches .lang-btn width

      // Parse embedded translations
      const dataEl = document.getElementById('i18n-data');
      const allTranslations: Record<string, unknown> = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};

      function getNestedValue(obj: unknown, path: string): unknown {
        const parts = path.split('.');
        let result = obj;
        for (const part of parts) {
          if (result && typeof result === 'object' && part in (result as Record<string, unknown>)) {
            result = (result as Record<string, unknown>)[part];
          } else {
            return undefined;
          }
        }
        return result;
      }

      function t(key: string, lang: Lang): string {
        const val = getNestedValue(allTranslations[lang], key);
        if (val !== undefined) return String(val);
        // Fallback to English
        const fallback = getNestedValue(allTranslations['en'], key);
        return fallback !== undefined ? String(fallback) : key;
      }

      function tArray(key: string, lang: Lang): string[] {
        const val = getNestedValue(allTranslations[lang], key);
        if (Array.isArray(val)) return val.map(String);
        const fallback = getNestedValue(allTranslations['en'], key);
        return Array.isArray(fallback) ? fallback.map(String) : [];
      }

      function getCurrentLang(): Lang {
        const stored = localStorage.getItem(LANG_KEY);
        if (stored && SUPPORTED.includes(stored as Lang)) return stored as Lang;
        return 'en';
      }

      // Apply translations to all elements with data-i18n attribute
      function applyTranslations(lang: Lang) {
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n!;
          const val = t(key, lang);
          // For mobile nav links, update only the text span, not the // prefix
          const textSpan = el.querySelector('.mobile-nav-text');
          if (textSpan) {
            textSpan.textContent = val;
          } else {
            el.textContent = val;
          }
        });

        // Apply HTML translations (for elements needing innerHTML like configureEmailJSSub)
        // Sanitize to prevent XSS — only allow a strict subset of safe tags
        const ALLOWED_TAGS = new Set(['code', 'strong', 'em', 'br', 'span']);
        function sanitizeHtml(html: string): string {
          return html.replace(/<\/?([a-zA-Z][a-zA-Z0-9]*)\b[^>]*>/g, (match, tag) => {
            return ALLOWED_TAGS.has(tag.toLowerCase()) ? match : '';
          });
        }
        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
          const key = el.dataset.i18nHtml!;
          const val = t(key, lang);
          el.innerHTML = sanitizeHtml(val);
        });

        // Apply placeholder translations
        document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-i18n-placeholder]').forEach((el) => {
          const key = el.dataset.i18nPlaceholder!;
          el.placeholder = t(key, lang);
        });

        // ── Dynamic content: About bio ──
        const bioContainer = document.getElementById('about-bio');
        if (bioContainer) {
          const bioText = t('about.bio', lang);
          const paragraphs = bioText.split('\n\n').filter(Boolean);
          // Use DOM API with textContent to prevent XSS
          bioContainer.innerHTML = '';
          paragraphs.forEach((text: string) => {
            const p = document.createElement('p');
            p.className = 'gsap-hidden mb-5';
            p.style.cssText = 'color: var(--text-secondary); line-height: 1.85; font-size: 0.95rem; opacity: 1; transform: none;';
            p.textContent = text;
            bioContainer.appendChild(p);
          });
        }

        // ── Dynamic content: About hobbies ──
        const hobbiesContainer = document.getElementById('about-hobbies');
        if (hobbiesContainer) {
          const hobbies = tArray('about.config.hobbies', lang);
          if (hobbies.length) {
            // Use DOM API with textContent to prevent XSS
            hobbiesContainer.innerHTML = '';
            hobbies.forEach((h: string, i: number) => {
              const span = document.createElement('span');
              span.style.color = '#e8b84b';
              span.textContent = `"${h}"`;
              hobbiesContainer.appendChild(span);
              if (i < hobbies.length - 1) {
                const comma = document.createElement('span');
                comma.textContent = ',';
                hobbiesContainer.appendChild(comma);
                hobbiesContainer.appendChild(document.createTextNode(' '));
              }
            });
          }
        }

        // ── Dynamic content: Timeline entries (role + description) ──
        const entries = getNestedValue(allTranslations[lang], 'experience.entries') as Array<{id: string; role: string; description: string}> | undefined;
        if (entries && Array.isArray(entries)) {
          // Validate entry IDs to prevent CSS selector injection
          const safeIdPattern = /^[\w-]+$/;
          for (const entry of entries) {
            if (!safeIdPattern.test(entry.id)) continue;
            document.querySelectorAll<HTMLElement>(`.timeline-role[data-entry-id="${entry.id}"]`).forEach((el) => {
              el.textContent = entry.role;
            });
            document.querySelectorAll<HTMLElement>(`.timeline-desc[data-entry-id="${entry.id}"]`).forEach((el) => {
              el.textContent = entry.description;
            });
          }
        }

        // Update html lang attribute
        document.documentElement.setAttribute('lang', lang);
        document.documentElement.dataset.lang = lang;

        // Update language toggle UI
        updateLangToggleUI(lang);

        // Dispatch event for React components and other listeners
        document.dispatchEvent(
          new CustomEvent('langchange', { detail: { lang } })
        );
      }

      function updateLangToggleUI(lang: Lang) {
        // Desktop toggles
        document.querySelectorAll<HTMLElement>('.lang-toggle-desktop').forEach((track) => {
          const indicator = track.querySelector<HTMLElement>('.lang-indicator');
          const buttons = track.querySelectorAll<HTMLButtonElement>('.lang-btn');
          const positions: Record<string, number> = { en: 0, ro: 1, it: 2 };
          const pos = positions[lang] ?? 0;
          if (indicator) indicator.style.transform = `translateX(${pos * BTN_WIDTH}px)`;
          buttons.forEach((btn) => {
            const active = btn.dataset.lang === lang;
            btn.classList.toggle('active', active);
            btn.setAttribute('aria-pressed', String(active));
          });
        });

        // Mobile toggles
        document.querySelectorAll<HTMLButtonElement>('.lang-btn-mobile').forEach((btn) => {
          const active = btn.dataset.lang === lang;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', String(active));
        });
      }

      function setLang(lang: Lang) {
        localStorage.setItem(LANG_KEY, lang);
        applyTranslations(lang);
      }

      // ─── Initial render + re-apply on every View Transition ───
      document.addEventListener('astro:page-load', () => applyTranslations(getCurrentLang()));

      // ─── Button clicks ─────────────────────────────────────────
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('.lang-btn, .lang-btn-mobile');
        if (!btn || !btn.dataset.lang) return;
        const lang = btn.dataset.lang as Lang;
        if (SUPPORTED.includes(lang)) {
          setLang(lang);
        }
      });

      // Expose for React components
      (window as any).__i18n = { t, tArray, getCurrentLang, setLang };
    </script>

    <!-- Scroll progress bar -->
    <script>
      let _scrollHandler: (() => void) | null = null;
      document.addEventListener('astro:page-load', () => {
        const progressBar = document.getElementById('scroll-progress');
        if (!progressBar) return;
        if (_scrollHandler) window.removeEventListener('scroll', _scrollHandler);
        _scrollHandler = () => {
          const scrolled = window.scrollY;
          const total = document.documentElement.scrollHeight - window.innerHeight;
          progressBar.style.width = total > 0 ? (scrolled / total * 100) + '%' : '0%';
        };
        window.addEventListener('scroll', _scrollHandler, { passive: true });
        _scrollHandler();
      });
    </script>

    <!-- BG FX + Scroll FX system -->
    <script is:inline>
      (function () {
        var FX_IDS = ['aurora', 'sparkles', 'dots', 'crosshatch', 'spotlight', 'supernova'];

        var isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

        function applyFx(v) {
          FX_IDS.forEach(function (id) {
            var el = document.getElementById('bg-' + id);
            if (el) el.classList.toggle('active', id === v);
          });
          // Skip canvas animation on touch devices — saves battery
          if (!isTouchDevice) {
            if (v === 'sparkles') startSparkles(); else stopSparkles();
          }
        }

        var sparkleAnim = null;
        function startSparkles() {
          var canvas = document.getElementById('sparkles-canvas');
          if (!canvas) return;
          var ctx = canvas.getContext('2d');
          function resize() {
            canvas.width  = window.innerWidth  * devicePixelRatio;
            canvas.height = window.innerHeight * devicePixelRatio;
          }
          resize();
          if (!startSparkles._resized) {
            window.addEventListener('resize', resize);
            startSparkles._resized = true;
          }
          var stars = Array.from({ length: 140 }, function () { return {
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 1.4 + 0.3,
            s: Math.random() * 0.4 + 0.1,
            phase: Math.random() * Math.PI * 2,
          }; });
          function frame(t) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            stars.forEach(function (s) {
              var a = 0.4 + Math.sin(t * 0.002 + s.phase) * 0.4;
              ctx.beginPath();
              ctx.fillStyle = 'rgba(235,233,228,' + (a * 0.7) + ')';
              ctx.arc(s.x, s.y, s.r * devicePixelRatio, 0, Math.PI * 2);
              ctx.fill();
              s.y += s.s;
              if (s.y > canvas.height) { s.y = 0; s.x = Math.random() * canvas.width; }
            });
            sparkleAnim = requestAnimationFrame(frame);
          }
          if (sparkleAnim) cancelAnimationFrame(sparkleAnim);
          sparkleAnim = requestAnimationFrame(frame);
        }
        function stopSparkles() {
          if (sparkleAnim) { cancelAnimationFrame(sparkleAnim); sparkleAnim = null; }
          var canvas = document.getElementById('sparkles-canvas');
          if (canvas) { var ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, canvas.width, canvas.height); }
        }

        // Spotlight follows mouse — skip on touch-only devices
        var isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
        if (!isTouch) {
          window.addEventListener('mousemove', function (e) {
            var sl = document.getElementById('bg-spotlight');
            if (sl) {
              sl.style.setProperty('--mx', e.clientX + 'px');
              sl.style.setProperty('--my', e.clientY + 'px');
            }
          }, { passive: true });
        }

        // Scroll-driven FX
        var sectionFxMap = {
          hero: 'aurora',
          desktop: 'dots',
          skills: 'crosshatch',
          projects: 'spotlight',
          experience: 'supernova',
          contact: 'sparkles',
        };
        var lastSectionId = null;
        function updateFxFromScroll() {
          var vpCenter = window.scrollY + window.innerHeight / 2;
          var bestId = null, bestDist = Infinity;
          Object.keys(sectionFxMap).forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            var rect = el.getBoundingClientRect();
            var top = rect.top + window.scrollY;
            var center = top + rect.height / 2;
            var dist = Math.abs(center - vpCenter);
            if (dist < bestDist) { bestDist = dist; bestId = id; }
          });
          if (bestId && bestId !== lastSectionId) {
            lastSectionId = bestId;
            applyFx(sectionFxMap[bestId]);
          }
        }
        var scrollRaf = null;
        window.addEventListener('scroll', function () {
          if (scrollRaf) return;
          scrollRaf = requestAnimationFrame(function () {
            updateFxFromScroll();
            scrollRaf = null;
          });
        }, { passive: true });

        document.addEventListener('astro:page-load', function () {
          lastSectionId = null;
          applyFx('aurora');
          updateFxFromScroll();
        });

      })();
    </script>

    <style is:global>
      /* === FIXED BG LAYERS === */
      .grid-bg {
        position: fixed; inset: 0;
        background-image:
          linear-gradient(rgba(235,233,228,0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(235,233,228,0.025) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none; z-index: 0;
      }
      .bg-aurora {
        position: fixed; inset: 0; pointer-events: none; z-index: 2;
        overflow: hidden; opacity: 0; transition: opacity 0.6s; mix-blend-mode: screen;
      }
      .bg-aurora.active { opacity: 1; }
      .bg-aurora::before, .bg-aurora::after {
        content: ''; position: absolute;
        width: 60vw; height: 60vw; border-radius: 50%; filter: blur(80px); opacity: 0.35;
      }
      .bg-aurora::before {
        top: -15vw; left: -10vw;
        background: radial-gradient(circle, var(--green) 0%, transparent 70%);
        animation: drift1 22s ease-in-out infinite;
      }
      .bg-aurora::after {
        bottom: -15vw; right: -10vw;
        background: radial-gradient(circle, var(--blue) 0%, transparent 70%);
        animation: drift2 28s ease-in-out infinite;
      }
      .bg-aurora-3 {
        position: absolute; top: 30%; left: 40%;
        width: 40vw; height: 40vw; border-radius: 50%;
        filter: blur(70px);
        background: radial-gradient(circle, var(--warm) 0%, transparent 70%);
        opacity: 0.18; animation: drift3 35s ease-in-out infinite;
      }
      @keyframes drift1 {
        0%, 100% { transform: translate(0,0) scale(1); }
        33% { transform: translate(20vw,10vh) scale(1.2); }
        66% { transform: translate(-10vw,30vh) scale(0.9); }
      }
      @keyframes drift2 {
        0%, 100% { transform: translate(0,0) scale(1); }
        50% { transform: translate(-30vw,-20vh) scale(1.3); }
      }
      @keyframes drift3 {
        0%, 100% { transform: translate(-50%,-50%) scale(1); }
        50% { transform: translate(-30%,-70%) scale(1.4); }
      }
      .bg-sparkles {
        position: fixed; inset: 0; pointer-events: none; z-index: 2;
        opacity: 0; transition: opacity 0.6s; mix-blend-mode: screen;
      }
      .bg-sparkles.active { opacity: 1; }
      .bg-sparkles canvas { width: 100%; height: 100%; display: block; }
      .bg-crosshatch {
        position: fixed; inset: 0; pointer-events: none; z-index: 2;
        opacity: 0; transition: opacity 0.6s; mix-blend-mode: screen;
        background-image:
          repeating-linear-gradient(45deg, transparent, transparent 8px, rgba(235,233,228,0.04) 8px, rgba(235,233,228,0.04) 9px),
          repeating-linear-gradient(-45deg, transparent, transparent 8px, rgba(235,233,228,0.04) 8px, rgba(235,233,228,0.04) 9px);
      }
      .bg-crosshatch.active { opacity: 1; }
      .bg-dots {
        position: fixed; inset: 0; pointer-events: none; z-index: 2;
        opacity: 0; transition: opacity 0.6s; mix-blend-mode: screen;
        background-image: radial-gradient(circle, rgba(235,233,228,0.18) 1px, transparent 1.5px);
        background-size: 28px 28px;
      }
      .bg-dots.active { opacity: 1; }
      .bg-spotlight {
        position: fixed; inset: 0; pointer-events: none; z-index: 2;
        opacity: 0; transition: opacity 0.6s; mix-blend-mode: screen;
        background: radial-gradient(circle 400px at var(--mx,50%) var(--my,50%), oklch(0.82 0.22 145 / 0.12) 0%, transparent 60%);
      }
      .bg-spotlight.active { opacity: 1; }
      .bg-supernova {
        position: fixed; inset: 0; pointer-events: none; z-index: 2;
        opacity: 0; transition: opacity 0.6s; mix-blend-mode: screen;
        display: flex; align-items: center; justify-content: center;
      }
      .bg-supernova.active { opacity: 1; }
      .bg-supernova::before {
        content: ''; width: 70vw; height: 70vw; border-radius: 50%;
        background: radial-gradient(circle, var(--green) 0%, transparent 35%);
        opacity: 0.18; animation: nova 6s ease-in-out infinite; filter: blur(40px);
      }
      .bg-supernova::after {
        content: ''; position: absolute;
        width: 4px; height: 4px; border-radius: 50%;
        background: var(--green);
        box-shadow: 0 0 20px var(--green), 0 0 60px var(--green), 0 0 120px var(--green);
        animation: novaCore 6s ease-in-out infinite;
      }
      @keyframes nova {
        0%, 100% { transform: scale(1); opacity: 0.18; }
        50% { transform: scale(1.15); opacity: 0.28; }
      }
      @keyframes novaCore {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.8); }
      }
      .scanlines {
        position: fixed; inset: 0;
        background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.12) 2px, rgba(0,0,0,0.12) 3px);
        pointer-events: none; z-index: 9990; opacity: 0.5;
      }
      .noise {
        position: fixed; inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
        pointer-events: none; z-index: 9991;
      }
      /* Scroll-bar */
      ::-webkit-scrollbar { width: 6px; height: 6px; }
      ::-webkit-scrollbar-track { background: var(--bg); }
      ::-webkit-scrollbar-thumb { background: var(--green); }
    </style>

  </body>
</html>
