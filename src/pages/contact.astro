---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile.json';

const pageTitle = `Contact ${profile.name} | Projects & Opportunities`;
const pageDescription = `Contact ${profile.name} about full-time roles, contract projects, or technical collaborations. You'll receive a personal reply within 2 business days.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar />

  <main id="main">
    <div class="page-breadcrumbs">
      <Breadcrumbs items={[
        { label: 'Home', href: '/', i18nKey: 'breadcrumbs.home' },
        { label: 'Contact', i18nKey: 'breadcrumbs.contact' },
      ]} />
    </div>
    <Contact />
    <FAQ />
  </main>

  <Footer />
</Layout>

<style>
  .page-breadcrumbs {
    position: absolute;
    z-index: 2;
    top: 88px;
    left: 32px;
    right: 32px;
  }
  @media (max-width: 720px) {
    .page-breadcrumbs { top: 72px; left: 16px; right: 16px; }
  }
</style>
