---
import Layout from '../layouts/Layout.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import RedesignHome from '../components/RedesignHome.astro';
import profile from '../data/profile.json';

const pageTitle = `${profile.name} | Full-Stack Software Engineer in Cluj-Napoca`;
const pageDescription = 'Full-stack engineer in Cluj-Napoca building Spring Boot services, Angular front ends, and dependable integration systems.';
---

<Layout title={pageTitle} description={pageDescription} bodyClass="home-redesign" defaultTheme="dark">
  <a href="#work" class="redesign-skip">Skip to selected work</a>
  <CommandPalette client:load />
  <RedesignHome />
</Layout>
