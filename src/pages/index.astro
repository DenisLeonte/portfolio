---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Timeline from '../components/Timeline.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import profile from '../data/profile.json';

const pageTitle = `${profile.name} — denis.exe`;
const pageDescription = `Full-Stack Software Engineer with 2+ years of experience. Spring Boot, React, Angular, AI & Big Data. Currently at Mercedes-Benz Group AG.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <a href="#about" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4">Skip to main content</a>

  <Navbar />
  <CommandPalette client:load />

  <main id="main">
    <Hero />

    <!-- Marquee 1: Tech Stack -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span class="mi">JAVA</span>
        <span class="mi outline">Spring Boot</span>
        <span class="mi">TypeScript</span>
        <span class="mi outline">React</span>
        <span class="mi">Angular</span>
        <span class="mi outline">PostgreSQL</span>
        <span class="mi">Docker</span>
        <span class="mi outline">Python</span>
        <span class="mi">PyTorch</span>
        <!-- duplicate for seamless loop -->
        <span class="mi">JAVA</span>
        <span class="mi outline">Spring Boot</span>
        <span class="mi">TypeScript</span>
        <span class="mi outline">React</span>
        <span class="mi">Angular</span>
        <span class="mi outline">PostgreSQL</span>
        <span class="mi">Docker</span>
        <span class="mi outline">Python</span>
        <span class="mi">PyTorch</span>
      </div>
    </div>

    <About />

    <!-- Marquee 2: Available -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track reverse">
        <span class="mi outline">Available for opportunities</span>
        <span class="mi">Available for opportunities</span>
        <span class="mi outline">Available for opportunities</span>
        <span class="mi">Available for opportunities</span>
        <span class="mi outline">Available for opportunities</span>
        <span class="mi">Available for opportunities</span>
      </div>
    </div>

    <Skills />
    <Projects />
    <Timeline />

    <!-- Marquee 3: CTA -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span class="mi">Let's build something</span>
        <span class="mi outline">Let's build something</span>
        <span class="mi">Let's build something</span>
        <span class="mi outline">Let's build something</span>
        <span class="mi">Let's build something</span>
        <span class="mi outline">Let's build something</span>
      </div>
    </div>

    <!-- Contact -->
    <section id="contact">
      <div class="contact-inner">
        <div class="contact-num">05 / contact</div>
        <h2 class="contact-title">
          Let's <em>talk.</em><br>
          <span class="contact-outline">Send a signal.</span>
        </h2>
        <div class="contact-grid">
          <p class="contact-sub">
            Open to full-time roles, contract work, or just nerding out about distributed systems and espresso.
            Drop a line — I read everything.
          </p>
          <div class="contact-channels">
            <a class="channel" href={`mailto:${profile.email}`}>
              <div>
                <div class="channel-name">Email</div>
                <div class="channel-sub">{profile.email}</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
            <a class="channel" href={profile.socialLinks.github} target="_blank" rel="noopener">
              <div>
                <div class="channel-name">GitHub</div>
                <div class="channel-sub">/DenisLeonte</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
            <a class="channel" href={profile.socialLinks.linkedin} target="_blank" rel="noopener">
              <div>
                <div class="channel-name">LinkedIn</div>
                <div class="channel-sub">/in/leontedenis</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
            <a class="channel" href="/resume.pdf" target="_blank">
              <div>
                <div class="channel-name">Resume</div>
                <div class="channel-sub">PDF, 1 page</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
            <a class="channel channel-cta" href="/contact">
              <div>
                <div class="channel-name">Contact Form</div>
                <div class="channel-sub">Send a message directly</div>
              </div>
              <div class="channel-arrow">↗</div>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Marquee */
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 28px 0;
    position: relative;
    z-index: 1;
    background: var(--bg);
  }
  .marquee-track {
    display: flex;
    gap: 48px;
    animation: scroll-x 30s linear infinite;
    white-space: nowrap;
    width: max-content;
  }
  .marquee-track.reverse { animation-direction: reverse; }
  .mi {
    font-family: var(--sans);
    font-size: clamp(24px, 6vw, 90px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 48px;
  }
  .mi::after {
    content: '✦';
    font-size: 0.4em;
    color: var(--green);
  }
  .mi:last-child::after { display: none; }
  .mi.outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--text);
  }
  @keyframes scroll-x {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Contact section */
  #contact {
    background: var(--bg);
    padding: 160px 32px 120px;
    position: relative;
    z-index: 1;
  }
  .contact-inner { max-width: 1400px; margin: 0 auto; }
  .contact-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .contact-title {
    font-family: var(--sans);
    font-size: clamp(48px, 9vw, 160px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: 60px;
    color: var(--text);
  }
  .contact-title em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }
  .contact-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    border-top: 1px solid var(--line);
    padding-top: 60px;
  }
  .contact-sub {
    font-size: 18px;
    color: var(--text-dim);
    line-height: 1.6;
    max-width: 460px;
  }
  .contact-channels { display: flex; flex-direction: column; }
  .channel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
    transition: padding 0.2s;
  }
  .channel:hover,
  .channel:active { padding-left: 12px; }
  .channel:first-child { border-top: 1px solid var(--line); }
  .channel-name {
    font-family: var(--sans);
    font-size: 20px;
    font-weight: 500;
  }
  .channel-sub {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.05em;
    margin-top: 4px;
  }
  .channel-arrow {
    font-family: var(--mono);
    font-size: 18px;
    color: var(--text-faint);
    transition: color 0.2s;
  }
  .channel:hover .channel-arrow { color: var(--green); }
  .channel-cta { border-color: var(--green); }
  .channel-cta .channel-name { color: var(--green); }
  .channel-cta .channel-arrow { color: var(--green); }

  @media (max-width: 768px) {
    #contact { padding: 80px 16px; }
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
