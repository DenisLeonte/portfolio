---
import profile from '../data/profile.json';
import projects from '../data/projects.json';

const name = 'Denis Leonte';
const title = `${profile.name} | Full-Stack Software Engineer in Cluj-Napoca`;
const description =
  'Full-stack software engineer in Cluj-Napoca building enterprise applications with Spring Boot, Angular, React, TypeScript, and data-driven technologies.';
const canonical = new URL('/', Astro.site);
const host = (url: string) => new URL(url).host;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical.href,
  name: title,
  description,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    url: canonical.href,
    email: profile.email,
    sameAs: [profile.socialLinks.github, profile.socialLinks.linkedin],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0b0b0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <noscript>
      <style>
        .rq { --bg: #f2f0ea; --fg: #111110; --dim: #55524b; --accent: #0b7a3b; }
        .rq [data-reveal] { opacity: 1 !important; transform: none !important; }
        .rq-canvas, .rq-rail, .rq-hud-bottom { display: none; }
      </style>
    </noscript>
  </head>

  <body>
    <div class="rq" id="rq" data-ground="dark">
      <a class="rq-skip" href="#data">Skip to content</a>
      <canvas class="rq-canvas" id="rq-canvas" aria-hidden="true"></canvas>

      <header class="rq-top">
        <a class="rq-name" href="/">{name}</a>
        <nav class="rq-nav" aria-label="Primary">
          <a href="#work">Work</a>
          <a href="/showcase">Showcase</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="rq-pill" href={`mailto:${profile.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
      </header>

      <div class="rq-hud-bottom" aria-hidden="true">
        <span class="rq-mono" data-hud="frame">the request · frame 1 of 6</span>
        <span class="rq-deg" data-hud="deg">040°</span>
        <span class="rq-mono rq-hud-right"><span data-hud="depth">overview</span> · Romania <span data-hud="time"></span></span>
      </div>
      <div class="rq-rail" aria-hidden="true"><span data-hud="dot"></span></div>

      <main>
        <section class="rq-frame rq-hero" data-frame="hero">
          <div class="rq-hero-inner">
            <p class="rq-mono rq-label" data-reveal>Full-stack software engineer</p>
            <h1 class="rq-h1">
              <span class="rq-h1-a" data-reveal>From backend</span>
              <span class="rq-h1-b" data-reveal>to frontend.</span>
            </h1>
            <p class="rq-intro" data-reveal>
              I'm Denis. I build complete applications. Scroll to follow one request from the database to the screen.
            </p>
            <p class="rq-mono rq-scroll" data-reveal>scroll <span aria-hidden="true">↓</span></p>
          </div>
        </section>

        <section class="rq-frame" data-frame="data" id="data">
          <div class="rq-copy">
            <p class="rq-mono rq-label rq-accent" data-reveal>04 · data · PostgreSQL</p>
            <h2 class="rq-h2" data-reveal>Every request starts in the dark.</h2>
            <p class="rq-p" data-reveal>
              M.Sc. in High Performance Computing and Big Data Analysis, Babeș-Bolyai University, 2024 to 2026.
              Distributed computing, parallel algorithms, large-scale data pipelines.
            </p>
          </div>
        </section>

        <section class="rq-frame" data-frame="service" id="service">
          <div class="rq-copy">
            <p class="rq-mono rq-label rq-accent" data-reveal>03 · service · Java · Spring Boot</p>
            <h2 class="rq-h2" data-reveal>Then something has to decide what it means.</h2>
            <p class="rq-p" data-reveal>
              .msg Systems Romania, since 2024. Spring Boot applications and enterprise platform integration on a
              Mercedes-Benz Group AG project, with teams across Romania and Germany.
            </p>
          </div>
        </section>

        <section class="rq-frame" data-frame="api" id="api">
          <div class="rq-copy">
            <p class="rq-mono rq-label rq-accent" data-reveal>02 · api · REST</p>
            <h2 class="rq-h2" data-reveal>It crosses a boundary.</h2>
            <p class="rq-p" data-reveal>
              System Integration / Full-Stack Developer: API integration and the real-world middleware between
              enterprise systems.
            </p>
          </div>
        </section>

        <section class="rq-frame rq-frame-long" data-frame="interface" id="work">
          <div class="rq-copy">
            <p class="rq-mono rq-label rq-accent" data-reveal>01 · interface · React · TypeScript</p>
            <h2 class="rq-h2" data-reveal>And finally someone sees it.</h2>
            <ul class="rq-projects">
              {
                projects.map((p, i) => (
                  <li data-reveal>
                    <a href={p.liveUrl} target="_blank" rel="noopener" data-project={i}>
                      <span class="rq-project-name">
                        {p.name} <span aria-hidden="true">↗</span>
                      </span>
                      <span class="rq-mono">{host(p.liveUrl)}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="rq-p rq-more" data-reveal>
              <a href="/showcase">More in the showcase: restaurants, e-commerce, agencies →</a>
            </p>
          </div>
        </section>

        <section class="rq-frame rq-frame-end" data-frame="response" id="contact">
          <div class="rq-copy rq-copy-wide">
            <p class="rq-mono rq-label rq-accent" data-reveal>response · delivered</p>
            <h2 class="rq-status" data-reveal aria-label="200 OK">
              <span data-status aria-hidden="true">200</span> <span class="rq-accent" aria-hidden="true">OK.</span>
            </h2>
            <p class="rq-lead" data-reveal>
              The request made it. Yours can start here: full-time roles, contract work, or a conversation about
              distributed systems and espresso.
            </p>
            <div class="rq-cta" data-reveal>
              <a class="rq-mail" href={`mailto:${profile.email}`} data-magnetic>
                {profile.email} <span aria-hidden="true">↗</span>
              </a>
              <span class="rq-mono">personal reply within 2 business days</span>
            </div>
            <footer class="rq-footer" data-reveal>
              <div class="rq-links">
                <a href={profile.socialLinks.github} target="_blank" rel="noopener">GitHub ↗</a>
                <a href={profile.socialLinks.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
                <a href="/resume.pdf" target="_blank">Resume ↗</a>
                <a href="/contact">Contact form</a>
              </div>
              <div class="rq-links rq-mono">
                <span>© {new Date().getFullYear()} {name}</span>
                <a href="/privacy">Privacy</a>
                <a href="/classic">Classic version</a>
              </div>
            </footer>
          </div>
        </section>
      </main>
    </div>

    <script>
      import { initRequestScene } from '../scripts/request-scene';

      const root = document.getElementById('rq') as HTMLElement;
      const canvas = document.getElementById('rq-canvas') as HTMLCanvasElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.classList.add('js');

      // Copy fades in line by line as each frame arrives.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) entry.target.classList.toggle('in', entry.isIntersecting);
        },
        { rootMargin: '-12% 0px -12% 0px' },
      );
      root.querySelectorAll('.rq-frame').forEach((frame) => {
        frame.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el, i) => {
          el.style.setProperty('--i', String(i));
          io.observe(el);
        });
      });

      // Live local time.
      const timeEl = root.querySelector<HTMLElement>('[data-hud="time"]');
      const tick = () => {
        if (!timeEl) return;
        timeEl.textContent = new Intl.DateTimeFormat('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          timeZone: 'Europe/Bucharest',
        }).format(new Date());
      };
      tick();
      setInterval(tick, 20_000);

      // The status code rolls up to 200 the first time the response arrives.
      const statusEl = root.querySelector<HTMLElement>('[data-status]');
      if (statusEl && !reduce) {
        let done = false;
        new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting || done) return;
            done = true;
            const start = performance.now();
            const roll = (now: number) => {
              const t = Math.min(1, (now - start) / 900);
              statusEl.textContent = String(Math.round(100 + 100 * (1 - Math.pow(1 - t, 3))));
              if (t < 1) requestAnimationFrame(roll);
            };
            requestAnimationFrame(roll);
          },
          { threshold: 0.6 },
        ).observe(statusEl);
      }

      // The email button leans slightly toward the cursor.
      const magnet = root.querySelector<HTMLElement>('[data-magnetic]');
      if (magnet && !reduce && window.matchMedia('(pointer: fine)').matches) {
        window.addEventListener(
          'pointermove',
          (e) => {
            const r = magnet.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            const near = Math.hypot(dx, dy) < 180;
            magnet.style.transform = near ? `translate(${dx * 0.12}px, ${dy * 0.18}px)` : '';
          },
          { passive: true },
        );
      }

      initRequestScene(root, canvas);
    </script>

    <style is:global>
      html { scroll-behavior: smooth; }
      body { margin: 0; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

      .rq {
        --bg: #0b0b0a;
        --fg: #eceae4;
        --dim: #a9a69e;
        --accent: #5cf08a;
        --pad: clamp(18px, 2.8vw, 40px);
        --hero: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: 'Geist', system-ui, -apple-system, 'Segoe UI', sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        transition: color 0.25s;
      }
      .rq *, .rq *::before, .rq *::after { box-sizing: border-box; }
      .rq a { color: inherit; text-underline-offset: 4px; }
      .rq a:hover { color: var(--accent); }
      .rq a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
      .rq-mono { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12px; letter-spacing: 0.01em; color: var(--dim); }
      .rq-accent { color: var(--accent); }

      .rq-skip { position: absolute; left: -9999px; }
      .rq-skip:focus { left: var(--pad); top: 12px; z-index: 30; background: var(--fg); color: var(--bg); padding: 10px 14px; }

      .rq-canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
      .rq.no-gl .rq-canvas { display: none; }

      /* ── Fixed chrome ─────────────────────────────── */
      .rq-top {
        position: fixed; z-index: 20; top: 0; left: 0; right: 0;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        padding: 18px var(--pad); font-size: 14px;
      }
      .rq-name { font-weight: 500; text-decoration: none; padding: 12px 0; }
      .rq-nav { display: flex; gap: clamp(16px, 2.4vw, 32px); }
      .rq-nav a { text-decoration: none; padding: 12px 0; }
      .rq-pill {
        text-decoration: none; border: 1px solid color-mix(in srgb, var(--fg) 50%, transparent);
        border-radius: 999px; padding: 11px 18px; white-space: nowrap; transition: background 0.2s, color 0.2s;
      }
      .rq a.rq-pill:hover { background: var(--fg); color: var(--bg); }

      .rq-hud-bottom {
        position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; pointer-events: none;
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 16px;
        padding: 0 var(--pad) 22px;
      }
      .rq-deg { font-weight: 300; font-size: clamp(24px, 2.4vw, 34px); line-height: 1; letter-spacing: -0.02em; color: var(--accent); font-variant-numeric: tabular-nums; }
      .rq-hud-right { text-align: right; }
      .rq-rail {
        position: fixed; z-index: 20; right: calc(var(--pad) * 0.5); top: 18vh; bottom: 14vh; width: 1px;
        background: color-mix(in srgb, var(--fg) 28%, transparent);
      }
      .rq-rail span { position: absolute; left: -3px; top: 0; width: 7px; height: 7px; margin-top: -3px; border-radius: 50%; background: var(--accent); }

      /* ── Frames ───────────────────────────────────── */
      /* Callouts pinned to objects in the scene (positioned by the scene script) */
      .rq-labels { position: fixed; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
      .rq-tag { position: absolute; left: 0; top: 0; opacity: 0; color: var(--fg); will-change: transform, opacity; }
      .rq-tag::before { content: ''; position: absolute; left: 0; top: 0; width: 28px; height: 1px; background: currentColor; opacity: 0.55; transform-origin: 0 0; transform: rotate(-45deg); }
      .rq-tag::after { content: ''; position: absolute; left: -2px; top: -2px; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
      .rq-tag span { position: absolute; left: 24px; top: -33px; white-space: nowrap; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: 0.02em; }
      .rq-tag-layer::before { width: 40px; transform: none; }
      .rq-tag-layer span { left: 48px; top: -8px; color: var(--dim); }

      .rq main { position: relative; z-index: 10; }
      .rq-frame { min-height: 175vh; padding: 0 var(--pad); }
      .rq-frame-long { min-height: 230vh; }
      .rq-frame-end { min-height: 150vh; }
      .rq-copy {
        position: sticky; top: 0; min-height: 100vh; min-height: 100svh;
        display: flex; flex-direction: column; justify-content: center; gap: 18px;
        max-width: min(40rem, 46vw); padding: 96px 0 84px;
      }
      .rq-copy-wide { max-width: min(64rem, 100%); }
      .rq-label { margin: 0; }
      .rq-h2 { margin: 0; font-weight: 300; font-size: clamp(38px, 5vw, 76px); line-height: 1.02; letter-spacing: -0.04em; text-wrap: balance; }
      .rq-p { margin: 0; max-width: 26rem; color: color-mix(in srgb, var(--fg) 84%, var(--bg)); }
      .rq-lead { margin: 0; max-width: 34rem; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.35; }

      .rq-hero { min-height: 100vh; min-height: 100svh; }
      .rq-hero-inner { position: relative; min-height: 100vh; min-height: 100svh; padding: 110px 0 78px; display: flex; flex-direction: column; }
      .rq-h1 { margin: clamp(16px, 5vh, 56px) 0 0; flex: 1; display: flex; flex-direction: column; justify-content: space-between; font-weight: 300; font-size: clamp(46px, 8.2vw, 128px); line-height: 1; letter-spacing: -0.045em; }
      .rq-h1 span { display: block; }
      .rq-h1-a { translate: calc(var(--hero) * -10vw) 0; }
      .rq-h1-b { align-self: flex-end; translate: calc(var(--hero) * 10vw) 0; margin-bottom: clamp(24px, 9vh, 96px); }
      .rq-hero-inner > * { opacity: calc(1 - var(--hero) * 1.8); }
      .rq-intro { margin: 0; max-width: 24rem; font-size: 17px; line-height: 1.45; }
      .rq-scroll { position: absolute; right: 0; top: 96px; margin: 0; }

      .rq-projects { list-style: none; margin: 8px 0 0; padding: 0; max-width: 28rem; }
      .rq-projects a {
        display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
        padding: 15px 0; text-decoration: none; border-top: 1px solid color-mix(in srgb, var(--fg) 30%, transparent);
        transition: padding 0.25s, color 0.2s;
      }
      .rq-projects li:last-child a { border-bottom: 1px solid color-mix(in srgb, var(--fg) 30%, transparent); }
      .rq-projects a:hover, .rq-projects a:focus-visible { padding-left: 12px; }
      .rq-projects a:hover .rq-mono { color: var(--accent); }
      .rq-project-name { font-size: clamp(21px, 2vw, 27px); letter-spacing: -0.02em; }
      .rq-more { font-size: 15px; }

      .rq-status { margin: 0; font-weight: 300; font-size: clamp(84px, 17vw, 250px); line-height: 0.9; letter-spacing: -0.06em; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .rq-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 6px; }
      .rq-mail { display: inline-block; background: var(--fg); color: var(--bg) !important; text-decoration: none; font-size: clamp(17px, 1.5vw, 20px); padding: 17px 28px; border-radius: 999px; transition: transform 0.25s ease-out; }
      .rq-footer { max-width: 40rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 32px; margin-top: clamp(20px, 5vh, 56px); font-size: 14px; }
      .rq-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0 24px; }
      .rq-links a { padding: 12px 0; color: inherit; }

      /* Line-by-line reveal (only once scripting is confirmed) */
      .rq.js [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(var(--i, 0) * 90ms); }
      .rq.js [data-reveal].in { opacity: 1; transform: none; }
      .rq.js .rq-hero-inner > [data-reveal].in, .rq.js .rq-hero-inner .rq-h1 { opacity: calc(1 - var(--hero) * 1.8); }

      @media (max-width: 899px) {
        .rq-nav { display: none; }
        .rq-copy { justify-content: flex-end; max-width: 100%; padding-bottom: 96px; gap: 14px; }
        .rq-frame-end .rq-copy { justify-content: center; }
        .rq-hud-bottom { grid-template-columns: 1fr auto; }
        .rq-hud-right { display: none; }
        .rq-scroll { display: none; }
        .rq-h1-b { margin-bottom: 20px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .rq.js [data-reveal] { transition: opacity 0.3s; transform: none; }
        .rq-h1-a, .rq-h1-b { translate: none; }
        .rq-mail { transition: none; }
      }
    </style>
  </body>
</html>
