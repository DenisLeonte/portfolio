---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PipelineFlow from '../components/PipelineFlow.tsx';
import profile from '../data/profile.json';

const pageTitle = `Tech Stack — ${profile.name}`;
const pageDescription = `The technologies and deployment pipeline powering ${profile.name}'s portfolio — Astro, React, GSAP, Cloudflare, and GitHub Actions.`;

const techStack = [
  {
    category: 'Framework & Language',
    code: '01',
    items: [
      { badge: 'AS', name: 'Astro', version: '4.16', desc: 'Static site generator with file-based routing and zero-JS-by-default React islands.' },
      { badge: 'RX', name: 'React', version: '18.3', desc: 'Powers interactive islands: command palette, contact form, and pipeline diagram.' },
      { badge: 'TS', name: 'TypeScript', version: '5.6', desc: 'Full type safety across all components, layouts, and JSON data files.' },
    ],
  },
  {
    category: 'Styling & Animation',
    code: '02',
    items: [
      { badge: 'TW', name: 'Tailwind CSS', version: '3.4', desc: 'Utility-first CSS layered with custom CSS properties for the v2 design system.' },
      { badge: 'IO', name: 'IntersectionObserver', version: null, desc: 'Native scroll-triggered animations — staggered reveals, skill bars, timeline rows.' },
      { badge: 'CS', name: 'CSS Custom Properties', version: null, desc: 'v2 design token system: oklch() colors, fluid type with clamp(), editorial layout.' },
    ],
  },
  {
    category: 'Infrastructure',
    code: '03',
    items: [
      { badge: 'GA', name: 'GitHub Actions', version: null, desc: 'CI/CD pipeline: auto-builds and deploys to GitHub Pages on every push to main.' },
      { badge: 'GH', name: 'GitHub Pages', version: null, desc: 'Production hosting at denistechs.com with a custom CNAME and automated versioning.' },
      { badge: 'CF', name: 'Cloudflare Workers', version: null, desc: 'Preview environments for feature branches via per-branch asset serving.' },
    ],
  },
  {
    category: 'Services',
    code: '04',
    items: [
      { badge: 'EJ', name: 'EmailJS', version: '4.4', desc: 'Client-side email delivery for the contact form — no backend required.' },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar />

  <main id="main">
    <!-- Hero -->
    <section id="tech-hero">
      <div class="page-inner">
        <div class="section-head">
          <div class="meta">
            <div class="section-num">00 / tech</div>
            <div class="section-tag">stack</div>
          </div>
          <h1 class="section-title">
            Under the <em>Hood.</em><br>
            <span class="title-outline">Full breakdown.</span>
          </h1>
        </div>
        <p class="hero-sub">
          Every tool in this portfolio was chosen deliberately. Here's the full breakdown — from the rendering engine down to the deployment pipeline.
        </p>
      </div>
    </section>

    <!-- Tech Stack -->
    <section id="tech-stack">
      <div class="page-inner">
        {techStack.map((group) => (
          <div class="tech-group">
            <div class="group-header">
              <span class="group-code">{group.code}</span>
              <span class="group-title">{group.category}</span>
            </div>
            <div class="tech-rows">
              {group.items.map((item, i) => (
                <div class="tech-row">
                  <div class="tech-badge">{item.badge}</div>
                  <div class="tech-name">{item.name}</div>
                  {item.version
                    ? <div class="tech-version">v{item.version}</div>
                    : <div class="tech-version">—</div>
                  }
                  <div class="tech-desc">{item.desc}</div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Pipeline -->
    <section id="tech-pipeline">
      <div class="page-inner">
        <div class="section-head" style="margin-bottom: 48px;">
          <div class="meta">
            <div class="section-num">// pipeline</div>
            <div class="section-tag">deployment flow</div>
          </div>
          <h2 class="section-title-sm">
            Deployment <em>Pipeline.</em>
          </h2>
        </div>
        <p class="pipeline-sub">
          Three environments, two merge paths, one production endpoint. Preview and staging are hosted on Cloudflare.
        </p>

        <div class="pipeline-wrap">
          <PipelineFlow client:load />
        </div>

        <div class="legend">
          <div class="legend-label">// environment_map</div>
          <div class="legend-rows">
            <div class="legend-row legend-head">
              <span>Branch</span>
              <span>Environment</span>
              <span>Host</span>
            </div>
            <div class="legend-row">
              <span><code>feature/*</code></span>
              <span>Preview</span>
              <span class="legend-dim">Cloudflare instance</span>
            </div>
            <div class="legend-row">
              <span><code>dev</code></span>
              <span>Staging</span>
              <span class="legend-dim">Cloudflare instance</span>
            </div>
            <div class="legend-row">
              <span><code>main</code></span>
              <span>Production</span>
              <span><a href="https://denistechs.com" target="_blank" rel="noopener">denistechs.com</a></span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #tech-hero {
    background: var(--bg);
    padding: 160px 32px 80px;
    position: relative;
    z-index: 1;
  }
  #tech-stack {
    background: var(--bg2);
    padding: 80px 32px 120px;
    position: relative;
    z-index: 1;
  }
  #tech-pipeline {
    background: var(--bg);
    padding: 120px 32px;
    position: relative;
    z-index: 1;
  }

  .page-inner { max-width: 1400px; margin: 0 auto; }

  /* Header */
  .section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 48px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .section-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .section-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-tag::before { content: '— '; opacity: 0.5; }
  .section-title {
    font-family: var(--sans);
    font-size: clamp(40px, 7vw, 120px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }
  .section-title em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }
  .title-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text);
  }
  .section-title-sm {
    font-family: var(--sans);
    font-size: clamp(28px, 4vw, 60px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0;
  }
  .section-title-sm em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }

  .hero-sub {
    max-width: 600px;
    font-size: 16px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-left: calc(33.33% + 80px);
    padding-top: 24px;
  }

  /* Tech groups */
  .tech-group { margin-bottom: 60px; }
  .group-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 0;
  }
  .group-code {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.15em;
  }
  .group-title {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--green);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Tech rows */
  .tech-rows { display: flex; flex-direction: column; }
  .tech-row {
    display: grid;
    grid-template-columns: 56px 200px 80px 1fr;
    gap: 32px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s, transform 0.5s;
  }
  .tech-row.visible { opacity: 1; transform: translateY(0); }
  .tech-row:hover { background: var(--bg3); padding-left: 12px; transition: padding 0.2s, opacity 0.5s, transform 0.5s, background 0.2s; }

  .tech-badge {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--green);
    letter-spacing: 0.08em;
    width: 40px; height: 40px;
    border: 1px solid var(--line-strong);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .tech-name {
    font-family: var(--sans);
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .tech-version {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.06em;
  }
  .tech-desc {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* Pipeline */
  .pipeline-sub {
    font-size: 16px;
    color: var(--text-dim);
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 40px;
    margin-left: calc(33.33% + 80px);
  }
  .pipeline-wrap {
    height: 960px;
    margin-bottom: 60px;
    border: 1px solid var(--line);
  }

  /* Legend */
  .legend-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--green);
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    opacity: 0.8;
  }
  .legend-rows { display: flex; flex-direction: column; }
  .legend-row {
    display: grid;
    grid-template-columns: 160px 200px 1fr;
    gap: 32px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    color: var(--text-dim);
  }
  .legend-row:first-child { border-top: 1px solid var(--line); }
  .legend-head {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .legend-row code {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--green);
  }
  .legend-row a {
    color: var(--green);
    text-decoration: none;
  }
  .legend-row a:hover { text-decoration: underline; }
  .legend-dim { color: var(--text-faint); font-style: italic; }

  @media (max-width: 1100px) {
    .section-head { grid-template-columns: 1fr; gap: 24px; }
    .hero-sub, .pipeline-sub { margin-left: 0; }
    .tech-row { grid-template-columns: 40px 1fr 1fr; }
    .tech-version { display: none; }
  }
  @media (max-width: 720px) {
    #tech-hero { padding: 100px 16px 60px; }
    #tech-stack { padding: 60px 16px 80px; }
    #tech-pipeline { padding: 80px 16px; }
    .tech-row { grid-template-columns: 40px 1fr; gap: 16px; }
    .tech-desc { display: none; }
    .pipeline-wrap { height: calc(100vw * 1.38); }
    .legend-row { grid-template-columns: 100px 1fr; gap: 16px; }
    .legend-row span:last-child { display: none; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const rows = document.querySelectorAll('.tech-row');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    rows.forEach(r => io.observe(r));
  });
</script>
