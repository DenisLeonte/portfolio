---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import showcase from '../../data/showcase.json';
---

<Layout title="Showcase — What I Can Build" description="A curated gallery of website templates built from scratch — restaurant, e-commerce, agency, blog, and real estate designs.">
  <Navbar />

  <main id="main">
    <!-- Hero -->
    <section id="showcase-hero">
      <div class="page-inner">
        <div class="section-head">
          <div class="meta">
            <div class="section-num">00 / showcase</div>
            <div class="section-tag">case studies</div>
          </div>
          <h1 class="section-title">
            What I Can <em>Build.</em><br>
            <span class="title-outline">No themes, no builders.</span>
          </h1>
        </div>
        <p class="hero-sub">
          Each template below is a fully interactive mini-site — designed and coded from scratch with distinct aesthetics, real animations, and production-quality UI.
          Need something custom? <a href="/contact" class="hero-link">Let's talk →</a>
        </p>
      </div>
    </section>

    <!-- Grid -->
    <section id="showcase-grid">
      <div class="page-inner">
        <div class="cards-grid">
          {showcase.map((entry, i) => (
            <a href={`/showcase/${entry.slug}`} class="showcase-card" style={`--accent: ${entry.colorPreview};`}>
              <div class="card-thumb">
                {entry.preview ? (
                  <img src={entry.preview} alt={`${entry.name} preview`} loading="lazy" />
                ) : (
                  <div class="thumb-placeholder">{entry.name.charAt(0)}</div>
                )}
                <div class="card-overlay">
                  <span class="overlay-text">View Template →</span>
                </div>
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="card-cat">{entry.category}</span>
                </div>
                <div class="card-name">{entry.name}</div>
                <div class="card-desc">{entry.description}</div>
                <div class="card-tags">
                  {entry.techHighlights.map(t => (
                    <span class="ctag">{t}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section id="showcase-cta">
      <div class="page-inner">
        <div class="cta-inner">
          <div class="cta-text">
            Each template designed and built from scratch —<br>
            <em>no themes, no page builders.</em>
          </div>
          <a href="/contact" class="btn-cta">Get In Touch →</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  #showcase-hero {
    background: var(--bg);
    padding: 160px 32px 80px;
    position: relative;
    z-index: 1;
  }
  #showcase-grid {
    background: var(--bg2);
    padding: 80px 32px 120px;
    position: relative;
    z-index: 1;
  }
  #showcase-cta {
    background: var(--bg);
    padding: 80px 32px;
    position: relative;
    z-index: 1;
  }

  .page-inner { max-width: 1400px; margin: 0 auto; }

  /* Header */
  .section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 48px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .section-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .section-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-tag::before { content: '— '; opacity: 0.5; }
  .section-title {
    font-family: var(--sans);
    font-size: clamp(40px, 7vw, 120px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--text);
    margin: 0;
  }
  .section-title em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--green);
  }
  .title-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text);
  }

  .hero-sub {
    max-width: 600px;
    font-size: 16px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-left: calc(33.33% + 80px);
  }
  .hero-link {
    color: var(--green);
    text-decoration: none;
  }
  .hero-link:hover { text-decoration: underline; }

  /* Cards */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .showcase-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    background: var(--bg2);
    transition: background 0.2s;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s, transform 0.5s, background 0.2s;
  }
  .showcase-card.visible { opacity: 1; transform: translateY(0); }
  .showcase-card:hover { background: var(--bg3); }

  .card-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
    background: var(--bg3);
  }
  .card-thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
    opacity: 0.85;
  }
  .showcase-card:hover .card-thumb img { transform: scale(1.04); }

  .thumb-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono);
    font-size: 60px;
    font-weight: 700;
    color: var(--accent, var(--green));
    opacity: 0.4;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 9, 8, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .showcase-card:hover .card-overlay { opacity: 1; }
  .overlay-text {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
    letter-spacing: 0.08em;
    border: 1px solid var(--line-strong);
    padding: 8px 16px;
  }

  .card-body {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--line);
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .card-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
  }
  .card-cat {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--green);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .card-name {
    font-family: var(--sans);
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .showcase-card:hover .card-name { color: var(--accent, var(--green)); }
  .card-desc {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.6;
    flex: 1;
  }
  .card-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .ctag {
    font-family: var(--mono);
    font-size: 9px;
    padding: 3px 8px;
    border: 1px solid var(--line);
    color: var(--text-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Bottom CTA */
  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 40px 0;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cta-text {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 3vw, 40px);
    color: var(--text);
    line-height: 1.2;
  }
  .cta-text em { color: var(--green); }
  .btn-cta {
    font-family: var(--mono);
    font-size: 11px;
    padding: 14px 22px;
    background: var(--green);
    border: 1px solid var(--green);
    color: var(--bg);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .btn-cta:hover { background: var(--bone, #e8e4dc); border-color: var(--bone, #e8e4dc); }

  @media (max-width: 1100px) {
    .section-head { grid-template-columns: 1fr; gap: 24px; }
    .hero-sub { margin-left: 0; }
    .cards-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    #showcase-hero { padding: 100px 16px 60px; }
    #showcase-grid { padding: 60px 16px 80px; }
    #showcase-cta { padding: 60px 16px; }
    .cards-grid { grid-template-columns: 1fr; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.showcase-card');
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08 });
    cards.forEach(c => io.observe(c));
  });
</script>
