---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Not Found | Leonte Denis"
  description="Page not found."
>
  <main
    class="flex items-center justify-center"
    style="min-height: 100vh; min-height: 100dvh; padding: 2rem; background: var(--bg-primary);"
  >
    <div style="max-width: 38rem; width: 100%;">
      <!-- Terminal window chrome -->
      <div
        style="border: 1px solid var(--border-green); border-radius: 8px; overflow: hidden; box-shadow: 0 0 40px var(--green-glow);"
      >
        <!-- Title bar -->
        <div
          style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; background: var(--bg-secondary); border-bottom: 1px solid var(--border-green);"
        >
          <span style="width:10px;height:10px;border-radius:50%;background:rgba(255,100,100,0.7);flex-shrink:0;"></span>
          <span style="width:10px;height:10px;border-radius:50%;background:rgba(255,200,50,0.6);flex-shrink:0;"></span>
          <span style="width:10px;height:10px;border-radius:50%;background:rgba(100,200,100,0.5);flex-shrink:0;"></span>
          <span style="font-size:0.7rem;color:var(--text-secondary);margin-left:0.5rem;letter-spacing:0.05em;">bash — 80×24</span>
        </div>

        <!-- Terminal body -->
        <div
          class="font-mono"
          style="padding: 1.5rem; background: var(--bg-primary); font-size: 0.82rem; line-height: 1.85;"
        >
          <!-- Previous session -->
          <div style="color: var(--text-secondary); opacity: 0.5; margin-bottom: 0.5rem;">
            Last login: Mon Mar 23 09:14:32 on ttys001
          </div>

          <!-- Command 1: navigate to path -->
          <div>
            <span style="color: var(--green-secondary);">user@portfolio</span><span style="color: var(--text-secondary);">:</span><span style="color: #2563eb;">~</span><span style="color: var(--text-secondary);">$</span>
            <span style="color: var(--text-primary); margin-left: 0.5rem;">cd /pages<span id="typed-path"></span></span>
          </div>

          <!-- Error output -->
          <div id="terminal-output" style="display:none; margin-top: 0.25rem;">
            <div>
              <span style="color: rgba(255,100,100,0.85);">bash:</span>
              <span style="color: var(--text-primary);"> cd: /pages<span id="error-path"></span>: </span>
              <span style="color: var(--text-secondary);">No such file or directory</span>
            </div>

            <!-- Command 2: ls -->
            <div style="margin-top: 0.75rem;">
              <span style="color: var(--green-secondary);">user@portfolio</span><span style="color: var(--text-secondary);">:</span><span style="color: #2563eb;">~</span><span style="color: var(--text-secondary);">$</span>
              <span style="color: var(--text-primary); margin-left: 0.5rem;">ls /pages/</span>
            </div>
            <div style="color: var(--green-muted); margin-top: 0.15rem; padding-left: 0.25rem;">
              <span style="color: var(--green-primary);">about/</span>&nbsp;&nbsp;
              <span style="color: var(--green-primary);">skills/</span>&nbsp;&nbsp;
              <span style="color: var(--green-primary);">projects/</span>&nbsp;&nbsp;
              <span style="color: var(--green-primary);">experience/</span>&nbsp;&nbsp;
              <span style="color: var(--green-primary);">contact/</span>
            </div>

            <!-- Command 3: suggestion -->
            <div style="margin-top: 0.75rem;">
              <span style="color: var(--green-secondary);">user@portfolio</span><span style="color: var(--text-secondary);">:</span><span style="color: #2563eb;">~</span><span style="color: var(--text-secondary);">$</span>
              <span style="color: var(--text-primary); margin-left: 0.5rem;">echo "Did you mean one of the above?"</span>
            </div>
            <div style="color: #e8b84b; margin-top: 0.15rem; padding-left: 0.25rem;">
              Did you mean one of the above?
            </div>

            <!-- Prompt with cursor and home link -->
            <div id="final-prompt" style="margin-top: 0.75rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <span>
                <span style="color: var(--green-secondary);">user@portfolio</span><span style="color: var(--text-secondary);">:</span><span style="color: #2563eb;">~</span><span style="color: var(--text-secondary);">$</span>
                <span style="color: var(--text-primary); margin-left: 0.5rem;">cd ~/home</span>
              </span>
              <span class="cursor-blink" aria-hidden="true"></span>
            </div>
            <div style="margin-top: 0.5rem;">
              <a href="/" class="btn-primary" style="display: inline-flex; font-size: 0.8rem; padding: 0.5rem 1.25rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H5M12 5l-7 7 7 7"/>
                </svg>
                Execute: cd ~/home
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- 404 label below terminal -->
      <p style="text-align:center; margin-top: 1.5rem; font-size: 0.72rem; color: var(--text-secondary); letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.6;">
        EXIT CODE 404 — NOT FOUND
      </p>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Get the current path to show in the fake command
    const fakePath = window.location.pathname.replace(/\/$/, '') || '/unknown';
    const typedPath = document.getElementById('typed-path');
    const errorPath = document.getElementById('error-path');
    if (errorPath) errorPath.textContent = fakePath;

    if (prefersReducedMotion) {
      if (typedPath) typedPath.textContent = fakePath;
      const output = document.getElementById('terminal-output');
      if (output) output.style.display = '';
      return;
    }

    // Type the path character by character
    let i = 0;
    const typeNext = () => {
      if (!typedPath) return;
      if (i < fakePath.length) {
        typedPath.textContent = fakePath.slice(0, ++i);
        setTimeout(typeNext, 55 + Math.random() * 40);
      } else {
        // Pause then show output
        setTimeout(() => {
          const output = document.getElementById('terminal-output');
          if (output) output.style.display = '';
        }, 400);
      }
    };
    setTimeout(typeNext, 600);
  });
</script>
